+            defer { defaults.removePersistentDomain(forName: suite) }
+            let store = VoiceSharingEnrollmentStore(
+                defaults: defaults, accountScopeProvider: { "account-a" },
+                sessionIdentityProvider: { [weak self] in self?.identity })
