+        tokenProvider: CloudTokenProviding,
+        session: URLSession = URLSession(configuration: .default),
+        requestIDFactory: @escaping () -> String = { UUID().uuidString.lowercased() },
+        // Default reads the in-memory lifecycle generation. NOTE: this deliberately does NOT read a
+        // credential — refresh rotation would look like logout, and credentials are not operation identity.
+        sessionIdentity: @escaping () -> SessionIdentity? = { VoiceSharingSessionGeneration.shared.currentGeneration() },
+        membershipStore: VoiceSharingEnrollmentStore = .shared
+    ) {
+        self.baseURLProvider = baseURLProvider
+        self.tokenProvider = tokenProvider
+        self.session = session
+        self.requestIDFactory = requestIDFactory
+        self.sessionIdentity = sessionIdentity
+        self.membershipStore = membershipStore
+    }
+
+    // MARK: - GET projection
+
+    /// Reads the current projection. Returns it together with the membership-operation fence value captured
+    /// BEFORE the request was issued, because the caller cannot reconstruct that instant afterwards: by the
+    /// time this returns, a withdrawal or account switch may already have bumped the fence, and applying such
+    /// a reply would re-enable a user who just opted out. `token` is nil when no lifecycle existed to read
+    /// under, which the caller must treat as "do not apply".
+    func fetchProjection() async -> FetchedProjection? {
+        // Identity is taken FIRST and must be non-nil: an unauthenticated session cannot be attributed, so
+        // it gets no request at all. The same value is re-checked after the credential await and after the
+        // response — otherwise a sign-out that lands while we are fetching would apply the previous
+        // account's projection.
+        // Captured at the same instant as the lifecycle: the fence value this read is issued under.
+        guard let readToken = membershipStore.projectionToken() else { return nil }
+        let identityAtStart = readToken.lifecycleGeneration
+        guard let request = await makeRequest(path: Self.projectionPath, method: "GET", body: nil) else { return nil }
+        guard sessionIdentity() == identityAtStart else { return nil }
+        do {
+            let (data, response) = try await session.data(for: request)
+            guard sessionIdentity() == identityAtStart else { return nil }
+            guard let http = response as? HTTPURLResponse else { return nil }
+            if http.statusCode == 401 || http.statusCode == 403 {
+                // Validate BEFORE the side effect, then report the bearer this request carried.
+                guard sessionIdentity() == identityAtStart else { return nil }
+                let rejected = request.value(forHTTPHeaderField: "Authorization")?.replacingOccurrences(of: "Bearer ", with: "")
+                await tokenProvider.handleUnauthorized(rejectedToken: rejected)
+            }
+            guard http.statusCode == 200 else { return nil }
+            guard let projection = Self.decodeProjection(data) else { return nil }
+            return FetchedProjection(membership: projection, issuedUnder: readToken)
+        } catch {
+            return nil
+        }
+    }
+
+    /// A projection plus the exact fence value it was read under. Application goes through the store, which
+    /// refuses unless both halves still match the live session — so an old GET cannot land after a
+    /// withdrawal or an account switch, whatever its revision string looks like.
+    struct FetchedProjection {
+        let membership: VoiceSharingMembership
+        let issuedUnder: VoiceSharingEnrollmentStore.ProjectionToken
+    }
+
+    // MARK: - POST enrollment / withdrawal
+
+    /// An operation's identity and body are IMMUTABLE once created, so a lost response can be retried with
+    /// the SAME `request_id` and body — which is what makes the server's idempotency rule reachable from the
+    /// public API. Minting a fresh UUID per call would defeat it: every retry would read as new intent, and
+    /// a delayed first delivery could no longer be recognised as a request the server already served.
+    struct MutationOperation {
+        let requestID: String
+        let path: String
+        /// Body must never contain credential material; it carries only contract fields.
+        let body: [String: Any]
+        /// Non-secret generation of the session that BEGAN this operation, retained across retries. A
+        /// `perform` under a different current generation refuses before touching the transport, so account
+        /// A's enrollment/withdrawal/deletion intent can never be sent while account B is signed in.
+        let originatingGeneration: SessionIdentity
+        /// The STORE fence value captured at BEGIN, retained unchanged across retries. Lifecycle identity
+        /// alone is not enough: a mutation issued before a local withdrawal can still succeed on the server
+        /// (the server has not moved yet), and its projection would then look applicable to a caller holding
+        /// a fresh token. Carrying the issuing fence on the operation means the outcome itself declares which
+        /// instant it belongs to, and the store refuses it after that instant passed.
+        let issuedUnder: VoiceSharingEnrollmentStore.ProjectionToken
+    }
+
+    /// One enrollment operation. Retry by calling `perform(_:)` again with the SAME operation (bounded
+    /// backoff), never by beginning another.
+    func beginEnrollment(acceptedDisclosureVersion: String, expectedMembershipRevision: String) -> MutationOperation? {
+        // Both fence halves are captured HERE, before any await, and travel with the operation forever.
+        guard let issuedUnder = membershipStore.projectionToken() else { return nil }
+        let generation = issuedUnder.lifecycleGeneration
+        let id = requestIDFactory()
+        return MutationOperation(
+            requestID: id,
+            path: Self.enrollmentPath,
+            body: [
+                Field.requestId: id,
+                Field.expectedRevision: expectedMembershipRevision,
+                Field.acceptedDisclosure: acceptedDisclosureVersion,
+            ],
+            originatingGeneration: generation,
+            issuedUnder: issuedUnder
+        )
+    }
+
+    /// `epoch` is nullable BY CONTRACT: null is valid only when the expected projection has no active
+    /// epoch, which is what lets an opt-out invalidate an outstanding opt-in. Neither form may withdraw a
+    /// later enrollment — that ordering is enforced server-side by the revision check.
+    func beginWithdrawal(enrollmentEpoch: String?, expectedMembershipRevision: String) -> MutationOperation? {
+        guard let issuedUnder = membershipStore.projectionToken() else { return nil }
+        let generation = issuedUnder.lifecycleGeneration
+        let id = requestIDFactory()
+        var body: [String: Any] = [
+            Field.requestId: id,
+            Field.expectedRevision: expectedMembershipRevision,
+        ]
+        // Explicit null on the wire when absent, so "no active epoch" is stated rather than omitted.
+        body[Field.epoch] = enrollmentEpoch ?? NSNull()
+        return MutationOperation(requestID: id, path: Self.withdrawalPath, body: body,
+                                 originatingGeneration: generation, issuedUnder: issuedUnder)
+    }
+
+    /// Performs an operation. Safe to call again with the SAME operation to retry a lost response: the
+    /// request_id and body are unchanged, so the server's idempotency rule applies instead of a second
+    /// mutation being recorded.
+    func perform(_ operation: MutationOperation) async -> VoiceSharingMutationOutcome {
+        // Refusal happens BEFORE any transport work: sending A's intent under B's credential would attribute
+        // one account's mutation to another, and the server cannot tell the difference.
+        guard sessionIdentity() == operation.originatingGeneration else { return .refusedStaleSession }
+        guard !operation.body.keys.contains(where: { $0.lowercased().contains("token") || $0.lowercased().contains("credential") }) else {
+            // Defensive: an operation body must never carry secret material in the first place.
+            return .unavailableBackend
+        }
+        return await mutate(
+            path: operation.path,
+            body: operation.body,
+            originatingGeneration: operation.originatingGeneration,
+            issuedUnder: operation.issuedUnder
+        )
+    }
+
+
+    // MARK: - DELETE accepted data (separate operation, separate request identity)
+
+    /// Deletion carries its own immutable request identity; retrying an unknown outcome must reuse BOTH the
+    /// original request_id and the original cutoff, since retries keep the same request identity per spec.
+    struct DeletionOperation {
+        let requestID: String
+        let body: [String: Any]
+        let originatingGeneration: SessionIdentity
+    }
+
+    func beginDeletion() -> DeletionOperation? {
+        guard let generation = sessionIdentity() else { return nil }
+        let id = requestIDFactory()
+        return DeletionOperation(requestID: id, body: [Field.requestId: id], originatingGeneration: generation)
+    }
+
+    /// Requires an explicit operation: there is no implicit "begin + send" form, because an unknown outcome
+    /// must be retried with the SAME identity and cutoff rather than re-minted here.
+    func performDeletion(_ operation: DeletionOperation) async -> VoiceSharingDeletionOutcome {
+        // Identity fence FIRST, before the credential await inside makeRequest — otherwise a transition that
+        // lands during token acquisition would go unnoticed by this path.
+        guard sessionIdentity() == operation.originatingGeneration else { return .unavailableBackend }
+        guard let request = await makeRequest(
+            path: Self.dataPath,
+            method: "DELETE",
+            body: op_body(of: operation)
+        ) else { return .unavailableBackend }
+        guard sessionIdentity() == operation.originatingGeneration else { return .unavailableBackend }
+        do {
+            let (data, response) = try await session.data(for: request)
+            guard let http = response as? HTTPURLResponse else { return .unavailableBackend }
+            // One guard before every status branch (see `mutate`): a deletion receipt, refusal, or 401
+            // belonging to a superseded session must not be reported under the current one.
+            guard sessionIdentity() == operation.originatingGeneration else { return .unavailableBackend }
+            switch http.statusCode {
+            case 202:
+                // A receipt is only a receipt if it says so in the contracted shape: schema_version 1,
+                // status exactly `deletion_pending`, and a non-empty opaque identifier. Anything else is an
+                // unknown outcome (retryable with the SAME operation), never a success to display.
+                guard let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+                      Self.isExactInteger(object[Field.schemaVersion], 1),
+                      (object[Field.status] as? String) == "deletion_pending",
+                      let id = Self.nonEmptyString(object[Field.deletionRequestId])
+                else { return .unavailableBackend }
+                return .pending(deletionRequestId: id)
+            case 401:
+                await tokenProvider.handleUnauthorized(rejectedToken: request.value(forHTTPHeaderField: "Authorization")?
+                    .replacingOccurrences(of: "Bearer ", with: ""))
+                return .unauthorized
+            case 403: return .refused(reason: .ineligible)
+            case 422: return .refused(reason: .invalidRequest)
+            default: return .unavailableBackend
+            }
+        } catch {
+            return .unavailableBackend
+        }
+    }
+
+    // MARK: - Shared mutation path
+
+    private func mutate(
+        path: String,
+        body: [String: Any],
+        originatingGeneration: SessionIdentity,
+        issuedUnder: VoiceSharingEnrollmentStore.ProjectionToken
+    ) async -> VoiceSharingMutationOutcome {
+        // The operation's own generation is the authority; `identityAtStart` is only the value observed right
+        // now, and both must agree before anything is sent.
+        guard sessionIdentity() == originatingGeneration else { return .refusedStaleSession }
+        guard let request = await makeRequest(path: path, method: "POST", body: body) else {
+            return .unavailableBackend
+        }
+        guard sessionIdentity() == originatingGeneration else { return .refusedStaleSession }
+        // NOTE: `mutate` is entered only after makeRequest() succeeded, which already required a non-nil
+        // identity; callers capture it before the credential await and pass it in so every comparison uses
+        // the same pre-await value rather than one read after network work began.
+        do {
+            let (data, response) = try await session.data(for: request)
+            guard let http = response as? HTTPURLResponse else { return .unavailableBackend }
+            // ONE guard, immediately after the transport returns and BEFORE any status branch. Every branch
+            // below produces an account-specific result — applied membership, a conflict projection, an
+            // ineligible/refused reason, or a token invalidation — so a reply from a superseded session must
+            // be dropped regardless of its code. Per-branch guards previously left 403 and 422 unguarded,
+            // which would have surfaced account A's refusal as account B's UI state.
+            guard sessionIdentity() == originatingGeneration else { return .refusedStaleSession }
+            switch http.statusCode {
+            case 200:
+                guard let projection = Self.decodeProjection(data) else { return .unavailableBackend }
+                // The outcome declares the instant it was issued at, so a caller CANNOT reconstruct a fresh
+                // fence after the reply lands. Without this, a delayed enrollment success arriving after a
+                // withdrawal would be applied under a token taken afterwards and re-enable collection.
+                return .applied(membership: projection, issuedUnder: issuedUnder)
+            case 409:
+                // A conflict carries the current projection. Surfacing it is required so the caller can show
+                // the real state; auto-replaying against the newer revision is forbidden. Reconciling with a
+                // NEW GET (whose own token decides applicability) is the only way to adopt newer state.
+                let current = Self.decodeProjection(data)
+                return .conflict(current: current, issuedUnder: issuedUnder)
+            case 401:
+                // Report the bearer THIS request actually carried — passing nil would fail every other
+                // cached token rather than just the refused one. Staleness was settled above.
+                let rejected = request.value(forHTTPHeaderField: "Authorization")?.replacingOccurrences(of: "Bearer ", with: "")
+                await tokenProvider.handleUnauthorized(rejectedToken: rejected)
+                return .unauthorized
+            case 403:
+                return .refused(reason: .ineligible)
+            case 422:
+                let reason = Self.refusalReason(from: data)
+                return .refused(reason: reason)
+            default:
+                return .unavailableBackend
+            }
+        } catch {
+            return .unavailableBackend
+        }
+    }
+
+    /// Builds the request. Callers capture session identity BEFORE awaiting here, because the credential
+    /// fetch is a suspension point where an account transition can land; this function never reads identity
+    /// itself, so there is exactly one pre-await capture per operation.
+    private func op_body(of operation: DeletionOperation) -> [String: Any] { operation.body }
+
+    private func makeRequest(path: String, method: String, body: [String: Any]?) async -> URLRequest? {
+        let base = baseURLProvider()
+        guard !base.isEmpty, let url = URL(string: base + path) else { return nil }
+        var request = URLRequest(url: url)
+        request.httpMethod = method
+        request.timeoutInterval = Self.defaultTimeoutSeconds
+        // Fail closed without a credential: no bearer, no call. Never fall back to a client-supplied
+        // identity — the server scopes ownership from the authenticated account.
+        guard let credential = await tokenProvider.token(), !credential.isEmpty else { return nil }
+        request.setValue("Bearer \(credential)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        if let body {
+            guard let encoded = try? JSONSerialization.data(withJSONObject: body) else { return nil }
+            request.httpBody = encoded
+        }
+        return request
+    }
+
+    // MARK: - Decoding
+
+    /// Unknown/partial/mismatched-schema input yields `nil` (or `.unavailable` membership) rather than a
+    /// permissive default: a parse failure must read as "not enrolled", never as permission.
+    /// Strict decoding. Every rule below exists because a lenient read would hand permission to something
+    /// the server never granted, so each failure returns nil rather than a default.
+    ///
+    /// Type strictness matters on this specific wire: `JSONSerialization` bridges JSON booleans to NSNumber,
+    /// and Swift's `as? Bool` will happily bridge an INTEGER (0/1) to Bool. A numeric publication must not
+    /// authorize collection, so booleans are checked as genuine boolean objects before use.
+    static func decodeProjection(_ data: Data) -> VoiceSharingMembership? {
+        guard let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }
+
+        // schema_version must be exactly the integer 1 — not "1", not 1.0, not absent.
+        guard Self.isExactInteger(object[Field.schemaVersion], 1) else { return nil }
+
+        guard let revision = nonEmptyString(object[Field.membershipRevision]) else { return nil }
+        guard let planRaw = nonEmptyString(object[Field.plan]), let plan = VoiceSharingMembership.Plan(rawValue: planRaw) else { return nil }
+        guard let enrolled = strictBool(object[Field.enrolled]) else { return nil }
+        guard let withdrawalRaw = nonEmptyString(object[Field.withdrawalState]),
+              let withdrawal = VoiceSharingMembership.WithdrawalState(rawValue: withdrawalRaw) else { return nil }
+
+        // Epoch / disclosure: absent means NSNull or missing; present must be non-empty text.
+        let epoch: String?
+        switch object[Field.epoch] {
+        case nil, is NSNull: epoch = nil
+        case let e as String where !e.trimmingCharacters(in: .whitespaces).isEmpty: epoch = e
+        default: return nil
+        }
+        let disclosure: String?
+        switch object[Field.acceptedDisclosure] {
+        case nil, is NSNull: disclosure = nil
+        case let d as String where !d.trimmingCharacters(in: .whitespaces).isEmpty: disclosure = d
+        default: return nil
+        }
+
+        // Consistency rules — an impossible combination is unknown state, never permission:
+        //  * active withdrawal_state with enrolled=false contradicts itself;
+        //  * enrollment without an epoch cannot authorize collection (records key on the epoch);
+        //  * an ACTIVE enrollment must carry the disclosure version it accepted;
+        //  * withdrawn/not_enrolled must not still claim enrollment.
+        if withdrawal == .active && !enrolled { return nil }
+        if enrolled && epoch == nil { return nil }
+        if enrolled && withdrawal == .withdrawn { return nil }
+        if enrolled && withdrawal == .notEnrolled { return nil }
+        if withdrawal == .active && disclosure == nil { return nil }
+
+        return VoiceSharingMembership(
+            membershipRevision: revision,
+            plan: plan,
+            voiceSharingEnrolled: enrolled,
+            enrollmentEpoch: epoch,
+            acceptedDisclosureVersion: disclosure,
+            withdrawalState: withdrawal
+        )
+    }
+
+    /// Exact integer match. `intValue` truncates (1.5 → 1) and `as? Int` bridges a Bool, so both are
+    /// rejected: the value must be a real number whose value is exactly the expected integer.
+    static func isExactInteger(_ value: Any?, _ expected: Int) -> Bool {
+        guard let number = value as? NSNumber else { return false }
+        guard CFGetTypeID(number) != CFBooleanGetTypeID() else { return false }
+        return number.compare(NSNumber(value: expected)) == .orderedSame
+    }
+
+    /// Non-empty trimmed string or nil; whitespace-only never counts as present.
+    private static func nonEmptyString(_ value: Any?) -> String? {
+        guard let s = value as? String else { return nil }
+        let trimmed = s.trimmingCharacters(in: .whitespacesAndNewlines)
+        return trimmed.isEmpty ? nil : s
+    }
+
+    /// Accepts only a genuine boolean object. An NSNumber holding 0/1 is REJECTED: JSONSerialization bridges
+    /// integers through `as? Bool`, so a permissive cast would let a numeric publication enable uploads.
+    static func strictBool(_ value: Any?) -> Bool? {
+        guard let number = value as? NSNumber else { return nil }
+        guard CFGetTypeID(number) == CFBooleanGetTypeID() else { return nil }
+        return number.boolValue
+    }
+
+    private static func refusalReason(from data: Data) -> VoiceSharingMutationOutcome.RefusalReason {
+        guard let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let code = object["error"] as? String else { return .invalidRequest }
+        if code.contains("disclosure") { return .unsupportedDisclosure }
+        if code.contains("ineligible") { return .ineligible }
+        return .invalidRequest
+    }
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingCaptureAllowance.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingCaptureAllowance.swift
new file mode 100644
index 000000000..dccda01e2
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingCaptureAllowance.swift
@@ -0,0 +1,396 @@
+import CryptoKit
+import Darwin
+import Foundation
+
+/// Capture admission only. These are not transferred-byte counters or a replacement for server quotas.
+struct VoiceSharingCaptureLimits: Equatable {
+    let dailyRecords: UInt64
+    let dailyBytes: UInt64
+    let clipSamples: Int
+    let metadataBytes: Int
+    let reservationBytes: UInt64
+
+    init?(dailyRecords: UInt64, dailyBytes: UInt64,
+          compiledRecordsCeiling: UInt64?, compiledBytesCeiling: UInt64?,
+          clipSamples: Int, metadataBytes: Int, compiledClipSamples: Int, compiledMetadataBytes: Int) {
+        guard let compiledRecordsCeiling, let compiledBytesCeiling,
+              dailyRecords > 0, dailyRecords <= compiledRecordsCeiling,
+              dailyBytes > 0, dailyBytes <= compiledBytesCeiling,
+              clipSamples > 0, clipSamples <= compiledClipSamples,
+              metadataBytes > 0, metadataBytes <= compiledMetadataBytes else { return nil }
+        let (audio, audioOverflow) = UInt64(clipSamples).multipliedReportingOverflow(by: 2)
+        let (wav, wavOverflow) = audio.addingReportingOverflow(44)
+        let (reservation, reservationOverflow) = wav.addingReportingOverflow(UInt64(metadataBytes))
+        guard !audioOverflow, !wavOverflow, !reservationOverflow, reservation <= dailyBytes else { return nil }
+        self.dailyRecords = dailyRecords
+        self.dailyBytes = dailyBytes
+        self.clipSamples = clipSamples
+        self.metadataBytes = metadataBytes
+        reservationBytes = reservation
+    }
+}
+
+struct VoiceSharingCaptureStamp: Equatable {
+    let session: String?
+    let epoch: String
+    let policyGeneration: Int
+}
+
+/// Construct off the callback from an established authority. There is no production window source yet.
+protocol VoiceSharingCaptureAccountScope {
+    var accountDigest: String { get }
+    var accountBinding: String { get }
+    var window: String { get }
+}
+
+struct VoiceSharingCaptureAuthorization: Equatable, VoiceSharingCaptureAccountScope {
+    let accountDigest: String
+    let accountBinding: String
+    let window: String
+    let limits: VoiceSharingCaptureLimits
+    let consent: VoiceSharingCaptureStamp
+
+    init?(account: String, establishedWindow: String?, limits: VoiceSharingCaptureLimits?, consent: VoiceSharingCaptureStamp) {
+        guard !account.isEmpty, account.utf8.count <= 512,
+              let establishedWindow, !establishedWindow.isEmpty, establishedWindow.utf8.count <= 512,
+              let limits else { return nil }
+        accountDigest = Self.digest(account)
+        accountBinding = Self.digest("auris-capture-allowance-account-v1:" + account)
+        window = establishedWindow
+        self.limits = limits
+        self.consent = consent
+    }
+
+    fileprivate static func digest(_ value: String) -> String {
+        SHA256.hash(data: Data(value.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+}
+
+/// Separate capability supplied only by trusted first-provisioning authority, never by normal admission.
+/// No production issuer exists. Synthetic controls construct this explicitly to establish their fixtures.
+struct VoiceSharingCaptureProvisioningAuthority: VoiceSharingCaptureAccountScope {
+    let accountDigest: String
+    let accountBinding: String
+    let window: String
+
+    /// Caller must have independent first-provisioning proof; a normal admission snapshot is insufficient.
+    init?(verifiedFirstProvisioningAccount account: String, establishedWindow: String) {
+        guard !account.isEmpty, account.utf8.count <= 512,
+              !establishedWindow.isEmpty, establishedWindow.utf8.count <= 512 else { return nil }
+        accountDigest = VoiceSharingCaptureAuthorization.digest(account)
+        accountBinding = VoiceSharingCaptureAuthorization.digest("auris-capture-allowance-account-v1:" + account)
+        window = establishedWindow
+    }
+}
+
+struct VoiceSharingCaptureReservation {
+    let clipSamples: Int
+    let metadataBytes: Int
+}
+
+protocol VoiceSharingCaptureAdmitting: AnyObject {
+    /// Memory-only and nonwaiting; no PCM may be retained until this succeeds.
+    func take(for stamp: VoiceSharingCaptureStamp) -> VoiceSharingCaptureReservation?
+    func requestPreparation()
+    func invalidate()
+}
+
+/// One prepaid token and one worker, not a pool. No collector lock is held by the storage path.
+final class VoiceSharingCaptureAllowance: VoiceSharingCaptureAdmitting {
+    private let ledger: VoiceSharingCaptureLedger
+    /// Memory-only current authority. Missing production values/window return nil before storage work.
+    private let currentAuthorization: () -> VoiceSharingCaptureAuthorization?
+    private let worker = DispatchQueue(label: "fm.auris.voicesharing.capture-allowance", qos: .utility)
+    private let lock = NSLock()
+    private var generation: UInt64 = 0
+    private var preparing = false
+    private var token: VoiceSharingCaptureAuthorization?
+
+    init(ledger: VoiceSharingCaptureLedger, currentAuthorization: @escaping () -> VoiceSharingCaptureAuthorization?) {
+        self.ledger = ledger
+        self.currentAuthorization = currentAuthorization
+    }
+
+    func take(for stamp: VoiceSharingCaptureStamp) -> VoiceSharingCaptureReservation? {
+        guard lock.try() else { return nil }
+        defer { lock.unlock() }
+        // Authority comparison and single-use consumption are one short memory decision.
+        guard let prepared = token else { return nil }
+        token = nil
+        guard prepared.consent == stamp, currentAuthorization() == prepared else { return nil }
+        return .init(clipSamples: prepared.limits.clipSamples, metadataBytes: prepared.limits.metadataBytes)
+    }
+
+    func requestPreparation() {
+        guard lock.try() else { return }
+        guard !preparing, token == nil else { lock.unlock(); return }
+        preparing = true
+        let startedGeneration = generation
+        lock.unlock()
+        worker.async { [weak self] in
+            guard let self else { return }
+            let authority = self.currentAuthorization()
+            // Validation precedes ledger creation, lock acquisition, and every durable charge.
+            let charged = authority.map { self.ledger.charge($0) } ?? false
+            self.lock.lock()
+            defer { self.lock.unlock() }
+            self.preparing = false
+            guard charged, let authority, self.generation == startedGeneration,
+                  self.currentAuthorization() == authority else { return }
+            self.token = authority
+        }
+    }
+
+    func invalidate() {
+        lock.lock()
+        generation &+= 1
+        token = nil
+        lock.unlock()
+    }
+
+    /// Joins only the worker, for deterministic controls; never called by admission/capture.
+    func waitForPreparationForTesting() { worker.sync {} }
+}
+
+/// A bounded, content-free ledger outside purgeable contribution content. No rollover is implemented.
+final class VoiceSharingCaptureLedger {
+    enum Barrier: String {
+        case claimDurable, genesisInitializing, initialUsage, genesisEstablished
+        case intentDurable, usageRenamed, usageDurable, intentSettled
+    }
+
+    private struct Envelope<Value: Codable>: Codable {
+        let payload: Value
+        let sha256: String
+    }
+
+    private struct Identity: Codable, Equatable {
+        let schema: Int
+        let account: String
+        let binding: String
+        let window: String
+        let incarnation: String
+    }
+
+    private struct Genesis: Codable {
+        let identity: Identity
+        let established: Bool
+    }
+
+    private struct Usage: Codable, Equatable {
+        let identity: Identity
+        let records: UInt64
+        let bytes: UInt64
+        let transaction: String?
+    }
+
+    private struct Intent: Codable {
+        let transaction: String
+        let before: Usage
+        let target: Usage
+    }
+
+    private enum Failure: Error { case unavailable }
+    /// One bounded process-wide exclusion also covers separate opens/instances; flock adds process isolation.
+    private static let processLock = NSLock()
+    private static let maximumDocumentBytes = 8 * 1024
+    private let root: URL
+    private let synchronize: (URL, Bool) throws -> Void
+    private let barrier: (Barrier) throws -> Void
+
+    init(root: URL, synchronize: @escaping (URL, Bool) throws -> Void = VoiceSharingCaptureLedger.sync,
+         barrier: @escaping (Barrier) throws -> Void = { _ in }) {
+        self.root = root
+        self.synchronize = synchronize
+        self.barrier = barrier
+    }
+
+    func charge(_ authority: VoiceSharingCaptureAuthorization) -> Bool {
+        access(authority, limits: authority.limits)
+    }
+
+    /// Initializes zero accounting only; never charges or issues a capture reservation.
+    func provision(_ authority: VoiceSharingCaptureProvisioningAuthority) -> Bool {
+        access(authority, limits: nil)
+    }
+
+    private func access<Scope: VoiceSharingCaptureAccountScope>(_ authority: Scope, limits: VoiceSharingCaptureLimits?) -> Bool {
+        guard Self.processLock.try() else { return false }
+        defer { Self.processLock.unlock() }
+        do { return try chargeLocked(authority, limits: limits) } catch { return false }
+    }
+
+    private func chargeLocked<Scope: VoiceSharingCaptureAccountScope>(_ authority: Scope, limits: VoiceSharingCaptureLimits?) throws -> Bool {
+        let firstProvisioning = limits == nil
+        let directory = root.appendingPathComponent(authority.accountDigest, isDirectory: true)
+        // Ordinary admission/recovery must not mistake lost accounting for first use.
+        if firstProvisioning { try createDirectoriesDurably(directory) }
+        let lockURL = directory.appendingPathComponent("claim.lock")
+        var created = false
+        var descriptor: Int32
+        if firstProvisioning {
+            descriptor = open(lockURL.path, O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW, S_IRUSR | S_IWUSR)
+            if descriptor >= 0 { created = true }
+        } else {
+            descriptor = open(lockURL.path, O_RDWR | O_NOFOLLOW)
+        }
+        guard descriptor >= 0 else { throw Failure.unavailable }
+        defer { close(descriptor) }
+        var info = stat()
+        guard fstat(descriptor, &info) == 0, info.st_mode & S_IFMT == S_IFREG,
+              flock(descriptor, LOCK_EX | LOCK_NB) == 0 else { throw Failure.unavailable }
+        defer { flock(descriptor, LOCK_UN) }
+        // Never infer initializer ownership from an earlier directory check; re-read under both locks.
+        let names = try boundedNames(directory)
+        let allowed: Set<String> = ["claim.lock", "genesis.json", "usage.json", "intent.json"]
+        guard names.isSubset(of: allowed) else { throw Failure.unavailable }
+        let genesisURL = directory.appendingPathComponent("genesis.json")
+        let usageURL = directory.appendingPathComponent("usage.json")
+        let intentURL = directory.appendingPathComponent("intent.json")
+        let genesis: Genesis
+        if created {
+            guard names == ["claim.lock"] else { throw Failure.unavailable }
+            try synchronize(lockURL, false)
+            try synchronize(directory, true)
+            try synchronize(root, true)
+            try barrier(.claimDurable)
+            let identity = Identity(schema: 1, account: authority.accountDigest, binding: authority.accountBinding,
+                                    window: authority.window, incarnation: UUID().uuidString)
+            try write(Genesis(identity: identity, established: false), to: genesisURL)
+            try barrier(.genesisInitializing)
+            try write(Usage(identity: identity, records: 0, bytes: 0, transaction: nil), to: usageURL)
+            try barrier(.initialUsage)
+            genesis = Genesis(identity: identity, established: true)
+            try write(genesis, to: genesisURL)
+            try barrier(.genesisEstablished)
+            return true
+        } else {
+            genesis = try read(Genesis.self, from: genesisURL)
+        }
+        guard genesis.established, matches(genesis.identity, authority) else { throw Failure.unavailable }
+        var usage = try read(Usage.self, from: usageURL)
+        guard usage.identity == genesis.identity else { throw Failure.unavailable }
+        if names.contains("intent.json") {
+            let intent = try read(Intent.self, from: intentURL)
+            let (nextRecords, overflow) = intent.before.records.addingReportingOverflow(1)
+            guard !overflow, intent.before.identity == genesis.identity,
+                  intent.target.identity == genesis.identity,
+                  UUID(uuidString: intent.transaction) != nil,
+                  intent.target.transaction == intent.transaction,
+                  intent.target.records == nextRecords, intent.target.bytes > intent.before.bytes,
+                  usage == intent.before || usage == intent.target else { throw Failure.unavailable }
+            // Conservatively retain the full old charge, even when no old token was issued.
+            // Recovery must confirm durability before settling; it never grants that process's token.
+            try write(intent.target, to: usageURL)
+            try removeIntent(intentURL, directory: directory)
+            usage = intent.target
+        }
+        guard let limits else { throw Failure.unavailable }
+        let (records, recordOverflow) = usage.records.addingReportingOverflow(1)
+        let (bytes, byteOverflow) = usage.bytes.addingReportingOverflow(limits.reservationBytes)
+        guard !recordOverflow, !byteOverflow,
+              records <= limits.dailyRecords, bytes <= limits.dailyBytes else { return false }
+        let transaction = UUID().uuidString
+        let target = Usage(identity: genesis.identity, records: records, bytes: bytes, transaction: transaction)
+        try write(Intent(transaction: transaction, before: usage, target: target), to: intentURL)
+        try barrier(.intentDurable)
+        try write(target, to: usageURL, afterRename: { try self.barrier(.usageRenamed) })
+        try barrier(.usageDurable)
+        try removeIntent(intentURL, directory: directory)
+        try barrier(.intentSettled)
+        return true
+    }
+
+    private func matches<Scope: VoiceSharingCaptureAccountScope>(_ identity: Identity, _ authority: Scope) -> Bool {
+        identity.schema == 1 && identity.account == authority.accountDigest && identity.binding == authority.accountBinding
+            && identity.window == authority.window && UUID(uuidString: identity.incarnation) != nil
+    }
+
+    private func createDirectoriesDurably(_ directory: URL) throws {
+        var missing: [URL] = []
+        var cursor = directory
+        while true {
+            var info = stat()
+            if lstat(cursor.path, &info) == 0 {
+                guard info.st_mode & S_IFMT == S_IFDIR else { throw Failure.unavailable }
+                break
+            }
+            guard errno == ENOENT, cursor.path != "/" else { throw Failure.unavailable }
+            missing.append(cursor)
+            cursor.deleteLastPathComponent()
+        }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        for created in missing.reversed() {
+            var info = stat()
+            guard lstat(created.path, &info) == 0, info.st_mode & S_IFMT == S_IFDIR else { throw Failure.unavailable }
+            try synchronize(created, true)
+            try synchronize(created.deletingLastPathComponent(), true)
+        }
+    }
+
+    private func boundedNames(_ directory: URL) throws -> Set<String> {
+        guard let enumerator = FileManager.default.enumerator(atPath: directory.path) else { throw Failure.unavailable }
+        var names = Set<String>()
+        while let name = enumerator.nextObject() as? String {
+            guard names.count < 4 else { throw Failure.unavailable }
+            names.insert(name)
+        }
+        return names
+    }
+
+    private func read<Value: Codable>(_ type: Value.Type, from url: URL) throws -> Value {
+        let descriptor = open(url.path, O_RDONLY | O_NOFOLLOW)
+        guard descriptor >= 0 else { throw Failure.unavailable }
+        let file = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+        defer { try? file.close() }
+        var info = stat()
+        guard fstat(descriptor, &info) == 0, info.st_mode & S_IFMT == S_IFREG,
+              info.st_size > 0, info.st_size <= Self.maximumDocumentBytes,
+              let data = try file.read(upToCount: Self.maximumDocumentBytes + 1),
+              data.count <= Self.maximumDocumentBytes else { throw Failure.unavailable }
+        let envelope = try JSONDecoder().decode(Envelope<Value>.self, from: data)
+        let payload = try canonical(envelope.payload)
+        let digest = SHA256.hash(data: payload).map { String(format: "%02x", $0) }.joined()
+        // Checksum catches numeric/string corruption too; exact own encoding rejects duplicate/extra keys.
+        guard digest == envelope.sha256, try canonical(envelope) == data else { throw Failure.unavailable }
+        return envelope.payload
+    }
+
+    private func encode<Value: Codable>(_ value: Value) throws -> Data {
+        let payload = try canonical(value)
+        let digest = SHA256.hash(data: payload).map { String(format: "%02x", $0) }.joined()
+        return try canonical(Envelope(payload: value, sha256: digest))
+    }
+
+    private func canonical<Value: Encodable>(_ value: Value) throws -> Data {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        let data = try encoder.encode(value)
+        guard data.count <= Self.maximumDocumentBytes else { throw Failure.unavailable }
+        return data
+    }
+
+    private func write<Value: Codable>(_ value: Value, to destination: URL, afterRename: () throws -> Void = {}) throws {
+        let temporary = destination.appendingPathExtension("next")
+        let data = try encode(value)
+        // A leftover temporary file is uncertainty evidence, never overwritten on a fresh attempt.
+        try data.write(to: temporary, options: .withoutOverwriting)
+        try synchronize(temporary, false)
+        guard rename(temporary.path, destination.path) == 0 else { throw Failure.unavailable }
+        try afterRename()
+        try synchronize(destination, false)
+        try synchronize(destination.deletingLastPathComponent(), true)
+    }
+
+    private func removeIntent(_ url: URL, directory: URL) throws {
+        try FileManager.default.removeItem(at: url)
+        try synchronize(directory, true)
+    }
+
+    private static func sync(_ url: URL, _ directory: Bool) throws {
+        let descriptor = open(url.path, O_RDONLY | O_NOFOLLOW)
+        guard descriptor >= 0 else { throw Failure.unavailable }
+        defer { close(descriptor) }
+        guard fsync(descriptor) == 0 else { throw Failure.unavailable }
+    }
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingCollector.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingCollector.swift
new file mode 100644
index 000000000..987b78034
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingCollector.swift
@@ -0,0 +1,1058 @@
+import Foundation
+import PocketCastsUtils
+
+/// Observes the microphone segment pipeline and turns eligible speech into bounded contribution work.
+///
+/// Why an observer rather than a stage inside recognition: the spec requires collecting wake-negative and
+/// bleed-rejected segments too, and those are silent `return`s inside `VoiceAsrEngine.processUtterance`. A
+/// consumer that only sees completion never observes them. So this type subscribes to the segmenter's
+/// confirmed start (with the confirming frame's real PCM), its in-progress accumulation (real new PCM per
+/// call), and its cancellation — plus the rejection branches — and does nothing else to the pipeline.
+///
+/// The four properties reviewers pinned, and which the controls name directly:
+///
+///   * **Actual PCM is capped.** The collector appends the REAL samples the segmenter produced (byte-for-byte
+///     slices, not counts or placeholders) into its own buffer up to a ceiling, and reports the real retained
+///     count, truncation and dropped spans. In memory a Float sample is 4 bytes.
+///   * **Association is by argument.** The engine freezes an immutable `CaptureContext` at utterance-launch
+///     and every outcome carries it. A successor starting first cannot adopt a predecessor's callback, and
+///     "whatever is current inside the collector" is never consulted for matching.
+///   * **Handoff is bounded and non-blocking**, and queued work is INVALIDATED at dequeue: an event whose
+///     epoch or authorizing session died while waiting in the FIFO never reaches the sink.
+///   * **All retained identity state is bounded**: open capture (≤1), FIFO (≤ maxPendingSignals), and the
+///     refusal sets (pruned to a floor once they exceed maxTerminalHistoryIDs).
+final class VoiceSharingCollector {
+
+    /// Ceiling on retained contribution audio for ONE capture, enforced as samples arrive. 60 s at 16 kHz.
+    /// This is a compiled ceiling, NOT an approved activation value — activation limits stay an owner decision.
+    static let maxRetainedSamples = 16_000 * 60
+
+    /// In-memory cost per retained sample (mono Float = 4 bytes). Any int16 conversion at queue time is the
+    /// queue's concern and is NOT claimed here.
+    static let bytesPerInMemorySample = 4
+
+    /// Events may queue before contribution work starts being dropped. FIFO, not fold-per-capture: folding
+    /// silently discarded the START event, so a completed contribution could reach the uploader with no
+    /// opening record and no frozen epoch.
+    static let maxPendingSignals = 64
+
+    /// Refusal-set ceiling. These sets answer one question — "is this callback for a capture I already
+    /// finished?" — only for captures recent enough that a late delivery is plausible. Events are delivered
+    /// per hop, so anything older than the live window cannot still be in flight; prune to half once exceeded.
+    static let maxTerminalHistoryIDs = 512
+
+    /// ONE aggregate ceiling over every float the collector OWNS, across open capture, FIFO events
+    /// (INCLUDING the one currently in the sink, counted until the sink call RETURNS — a release at
+    /// dequeue would declare still-retained bytes free while the sink is mid-delivery), and the
+    /// terminal ring — enforced, not merely documented. At the compiled ceilings this allows
+    /// 4 × 960,000 samples = 3.84 M floats = **15.36 MB** (mono Float, 4 bytes): one slot for the open
+    /// capture, one for ring-held late-outcome audio, two for FIFO-held event audio (which includes the
+    /// one transient COW copy made when a completed capture's buffer is shared between the ring entry
+    /// and its event — arrays share storage until mutated, so accounting counts each owner, not raw
+    /// uniqueness). EXACT OWNERSHIP BOUNDARIES: a delivered event's bytes leave this budget when the
+    /// sink returns — from that point the sink/uploader is the owner and the budget cannot see it;
+    /// a dropped event's bytes leave immediately; ring-held bytes stay counted until eviction or
+    /// disposal. Exceeding the ceiling drops the NEWEST contribution work (same policy as the FIFO
+    /// bound) and counts the drop.
+    static let maxAggregateRetainedSamples = 4 * maxRetainedSamples
+
+    /// Half-open sample interval `[start, end)` on the original segment timeline.
+    struct DropSpan: Equatable {
+        let start: Int
+        let end: Int
+    }
+
+    enum SignalKind: Equatable {
+        case started, completed, cancelled, rejectedBleed, rejectedWake
+    }
+
+    /// Immutable association token handed to the engine at confirmed start and REQUIRED on every later
+    /// outcome for that segment. Association by argument, not by "whatever is current": utterance B starting
+    /// before A's rejection arrives cannot make A's callback land on B, because A's Task holds A's context
+    /// and the collector matches it explicitly.
+    struct CaptureContext: Equatable {
+        let id: UUID
+        let epoch: String
+        let session: String?
+    }
+
+    struct SegmentEvent: Equatable {
+        let kind: SignalKind
+        let captureID: UUID
+        let enrollmentEpoch: String
+        /// Session that authorized this record, frozen with the epoch. Queued events are checked against the
+        /// LIVE session at dequeue; a mismatch means the account moved while this event waited, and the sink
+        /// never sees it.
+        var authorizationSession: String?
+        /// Samples actually kept by the collector — never more than `maxRetainedSamples`.
+        let retainedSamples: Int
+        let truncated: Bool
+        let droppedSpans: [DropSpan]
+        /// Original duration when known; nil means "unknown", recorded explicitly rather than fabricated.
+        let originalSampleCount: Int?
+        /// The retained contribution audio itself, delivered WITH the event. A handoff that carries counts
+        /// and forces the uploader to come back for bytes is a second channel to keep consistent; the audio
+        /// rides with the record that describes it.
+        let audio: [Float]
+        /// True for gate-control records (e.g. the cancellation synthesized by gate loss). These BYPASS the
+        /// live dequeue check: their whole purpose is to report that consent ended, so gating them on the
+        /// (now-closed) gate would drop the evidence of the drop.
+        let isGateControl: Bool
+        /// What the ENGINE actually reported while this capture was open (review c48461e6): the stage
+        /// observations carried on the event, so downstream claims describe observations that really
+        /// happened rather than claims a caller supplied. Empty for legacy/gate-control events.
+        var reportedStages: [String: VoiceSharingContributionEncoder.StageOutcome] = [:]
+        var outcomeWaitExpired = false
+        /// A collector event freezes actual invocation identities, including explicit unknown slots.
+        var reportedModels: VoiceSharingContributionEncoder.Models? = nil
+        var metadataByteCeiling = VoiceSharingUploadQueue.maxMetadataBytes
+    }
+
+    /// Validated scheduling input, not an activation default. Missing limits close admission.
+    struct OutcomeWaitLimit {
+        let nanoseconds: Int
+
+        init?(milliseconds: Int, ceilingMilliseconds: Int? = nil) {
+            guard let ceilingMilliseconds, ceilingMilliseconds > 0,
+                  ceilingMilliseconds <= Int.max / 1_000_000,
+                  milliseconds > 0, milliseconds <= ceilingMilliseconds else { return nil }
+            nanoseconds = milliseconds * 1_000_000
+        }
+    }
+
+    private struct OutcomeDeadline {
+        let time: DispatchTime
+        let work: DispatchWorkItem
+    }
+
+    private var outcomeDeadlines: [UUID: OutcomeDeadline] = [:]
+    private let outcomeWaitLimit: OutcomeWaitLimit?
+    private let monotonicNow: () -> DispatchTime
+    private let scheduleOutcome: (DispatchTime, DispatchWorkItem) -> Void
+
+    private struct FrozenCapture {
+        let id: UUID
+        /// Stage observations the engine reported for THIS capture, accumulated as its signals arrive.
+        var reportedStages: [String: VoiceSharingContributionEncoder.StageOutcome] = [:]
+        let epoch: String
+        let session: String?
+        var modelReferences: [String: VoiceSharingContributionEncoder.ModelRef] = [:]
+        var observedModelSlots: Set<String> = []
+        var conflictingModelSlots: Set<String> = []
+        var clipSampleCeiling = VoiceSharingCollector.maxRetainedSamples
+        var metadataByteCeiling = VoiceSharingUploadQueue.maxMetadataBytes
+        var retained: [Float] = []
+        var sawStart = false
+        var droppedFrom: Int? = nil
+        var original: Int? = nil
+        var terminal = false
+        /// Held until the engine finalizes the capture (downstream ASR/translation/routing complete).
+        /// Without this, the record is emitted at segmentation time and can never carry a downstream stage.
+        /// OPT-IN: a consumer that emits directly (and never finalizes) keeps the immediate behaviour.
+        var deferEmissionUntilFinalized = false
+    }
+
+    private let captureAllowance: VoiceSharingCaptureAdmitting?
+    private let policy: VoiceSharingPolicy
+    private let membership: () -> VoiceSharingEnrollmentStore.State
+    private let epochProvider: () -> String?
+    private let sessionIdentity: () -> String?
+
+    /// Off-callback sink. Invoked on the collector's OWN serial queue, never on the capture thread.
+    private let sink: (SegmentEvent) -> Void
+    private let workQueue = DispatchQueue(label: "fm.auris.voicesharing.collector", qos: .utility,
+                                          attributes: [], autoreleaseFrequency: .workItem)
+
+    private let lock = NSLock()
+    /// Monotonic stamp for ring entry order (see `TerminalRecord.deferredOrder`).
+    private var terminalSequence: UInt64 = 0
+    /// The capture currently open, with everything about it frozen at creation. Replaced (not mutated) when a
+    /// new segment starts, so an old callback can never land on the successor.
+    private var current: FrozenCapture?
+    /// Bounded FIFO of events awaiting delivery.
+    private var pending: [SegmentEvent] = []
+    /// Captures that have emitted a terminal event, and the same information as the wider refusal set. Any
+    /// later callback naming one is refused. Bounded: see `pruneTerminalHistoryIfNeeded`.
+    private var terminalIDs = Set<UUID>()
+    private var obsoleteCaptures = Set<UUID>()
+    private(set) var overflowCount = 0
+
+    /// TEST ONLY. Delivery is asynchronous in production — that is the non-blocking property under review —
+    /// so content assertions use inline delivery instead of racing a scheduler. The held-sink and
+    /// thread-identity controls keep real async delivery; that is where non-blocking is actually proven.
+    var deliversSynchronouslyForTesting = false
+
+    init(
+        policy: VoiceSharingPolicy,
+        captureAllowance: VoiceSharingCaptureAdmitting? = nil,
+        outcomeWaitLimit: OutcomeWaitLimit? = nil,
+        monotonicNow: @escaping () -> DispatchTime = DispatchTime.now,
+        scheduleOutcome: @escaping (DispatchTime, DispatchWorkItem) -> Void = {
+            DispatchQueue.global(qos: .utility).asyncAfter(deadline: $0, execute: $1)
+        },
+        membership: @escaping () -> VoiceSharingEnrollmentStore.State = { VoiceSharingEnrollmentStore.shared.currentState },
+        epochProvider: @escaping () -> String? = { VoiceSharingEnrollmentStore.shared.activeEnrollmentEpoch },
+        sessionIdentity: @escaping () -> String? = { VoiceSharingSessionGeneration.shared.currentGeneration() },
+        sink: @escaping (SegmentEvent) -> Void = { _ in }
+    ) {
+        self.captureAllowance = captureAllowance
+        self.outcomeWaitLimit = outcomeWaitLimit
+        self.monotonicNow = monotonicNow
+        self.scheduleOutcome = scheduleOutcome
+        self.policy = policy
+        self.membership = membership
+        self.epochProvider = epochProvider
+        self.sessionIdentity = sessionIdentity
+        self.sink = sink
+    }
+
+    deinit {
+        for deadline in outcomeDeadlines.values { deadline.work.cancel() }
+    }
+
+    // MARK: - Gate
+
+    /// Re-read at EVERY decision. Cached permission is exactly what the spec forbids.
+    /// Called WITHOUT `lock` held. Returns the epoch when collection is permitted, so the value frozen into
+    /// the capture is the same one that authorized it.
+    private func permittedEpoch() -> String? {
+        guard outcomeWaitLimit != nil, policy.permitsCollection else { return nil }
+        let state = membership()
+        // Unknown membership (no projection accepted this session) is NOT permission. Stale likewise.
+        guard state.hasAuthoritativeProjection, state.effectiveEnrolled else { return nil }
+        guard let epoch = epochProvider(), !epoch.isEmpty else { return nil }
+        return epoch
+    }
+
+    /// The gate rule that stops an ALREADY-OPEN capture: "Unknown/stale must stop before another SEGMENT" is
+    /// necessary but not sufficient — an open partial must also stop when the gate moves under it. Every
+    /// non-start signal passes through here. Does NOT take `lock`; callers hold it.
+    private func stillPermitted(for c: FrozenCapture) -> Bool {
+        guard let epoch = permittedEpoch() else { return false }
+        return epoch == c.epoch && sessionIdentity() == c.session
+    }
+
+    // MARK: - Pipeline signals
+
+    /// Confirmed speech start. Assigns `capture_id` here and returns the immutable context the engine must
+    /// freeze into its utterance Task — or opens nothing (returns nil) when the gate is closed.
+    @discardableResult
+    func speechStarted(confirmationFrameSamples: Int) -> CaptureContext? {
+        guard let epoch = permittedEpoch() else {
+            abandonForGateMove(context: currentCaptureContext())
+            return nil
+        }
+        let session = sessionIdentity()
+        let stamp = VoiceSharingCaptureStamp(session: session, epoch: epoch, policyGeneration: policy.currentLeaseGeneration)
+        // The first contribution-owned PCM copy occurs only after taking this prepaid, single-use token.
+        let admission = captureAllowance?.take(for: stamp)
+        captureAllowance?.requestPreparation()
+        guard let admission else {
+            abandonForGateMove(context: currentCaptureContext())
+            return nil
+        }
+        var frozen = FrozenCapture(id: UUID(), epoch: epoch, session: session,
+                                   retained: [], sawStart: true, original: confirmationFrameSamples)
+        frozen.clipSampleCeiling = min(Self.maxRetainedSamples, admission.clipSamples)
+        frozen.metadataByteCeiling = min(VoiceSharingUploadQueue.maxMetadataBytes, admission.metadataBytes)
+        lock.lock()
+        guard stillPermitted(for: frozen), policy.currentLeaseGeneration == stamp.policyGeneration else {
+            lock.unlock()
+            return nil
+        }
+        // The segmenter owns one capture at a time, so a confirmed start while a partial still lingers
+        // means the partial can never complete. Record it (bounded ring + cancellation record) instead of
+        // silently overwriting it — a silent overwrite would strand its audio with no terminal record.
+        var staleEvent: SegmentEvent?
+        if let stale = current, !stale.terminal {
+            var abandoned = stale
+            abandoned.terminal = true
+            current = nil
+            aggregateAudioSamples -= abandoned.retained.count
+            markTerminal(abandoned, discarded: true)
+            staleEvent = makeEvent(kind: .cancelled, from: abandoned)
+        }
+        current = frozen
+        let startEvent = makeEvent(kind: .started, from: frozen)
+        let context = CaptureContext(id: frozen.id, epoch: epoch, session: frozen.session)
+        lock.unlock()
+        if let staleEvent { submit(staleEvent) }
+        submit(startEvent)
+        return context
+    }
+
+    /// SYNCHRONOUS segmentation endpoint, called by the engine's onUtterance closure BEFORE it creates
+    /// the outcome Task: the segmenter has finished THIS segment, so its audio is frozen and detached
+    /// HERE — before any successor can start and before any await. Without this, a completed capture
+    /// still sitting in `current` would be turned into an audio-carrying cancel by B's start, and the
+    /// late outcome would emit a SECOND record. Emits NO event: the accept/reject decision arrives
+    /// later via the frozen context and emits exactly once from the ring.
+    func segmentationEnded(_ context: CaptureContext?) {
+        lock.lock()
+        guard let context, let c = current, c.id == context.id, !c.terminal else {
+            lock.unlock()
+            return
+        }
+        var done = c
+        done.terminal = true
+        current = nil
+        aggregateAudioSamples -= done.retained.count
+        markTerminal(done)
+        let deadline = registerOutcomeDeadlineLocked(for: done.id)
+        lock.unlock()
+        if let deadline { scheduleOutcome(deadline.time, deadline.work) }
+    }
+
+    /// The context of the capture currently open, for the engine to freeze into its utterance Task. Nil when
+    /// nothing is open — a later completion then carries nil and is refused, which is correct: an utterance
+    /// with no confirmed start has nothing to attach to.
+    func currentCaptureContext() -> CaptureContext? {
+        lock.lock(); defer { lock.unlock() }
+        guard let c = current else { return nil }
+        return CaptureContext(id: c.id, epoch: c.epoch, session: c.session)
+    }
+
+    /// Test seam: same value production reads. Named separately so a test passing a STALE context
+    /// deliberately does not reach for the live one by accident.
+    var currentCaptureContextForTesting: CaptureContext? { currentCaptureContext() }
+
+    /// Pointer metadata only; nil in production. Detects an accidental pre-admission PCM copy.
+    var borrowedSampleAddressForTesting: ((UInt?) -> Void)?
+
+    /// Appends the REAL PCM the segmenter just produced. `samples` is authoritative; `reportedTotal` only
+    /// documents the segmenter's buffer size so the original duration can be stated.
+    func appendSamples<Samples: Collection>(_ samples: Samples, reportedTotal: Int? = nil) where Samples.Element == Float {
+        if let probe = borrowedSampleAddressForTesting {
+            _ = samples.withContiguousStorageIfAvailable { buffer in
+                probe(buffer.baseAddress.map { UInt(bitPattern: $0) })
+            }
+        }
+        lock.lock()
+        guard var c = current, !c.terminal, c.sawStart else { lock.unlock(); return }
+        guard stillPermitted(for: c) else { lock.unlock(); return }
+        // Release the `current` reference while mutating: with both `current` and `c` holding the array,
+        // every append would trigger a copy-on-write of the WHOLE buffer (O(n²) per segment). With `c`
+        // uniquely owned, `append` writes in place. Restored before unlock.
+        current = nil
+        // Reserve BEFORE growth: the open capture may not push the aggregate over budget even though
+        // its own per-capture cap still has room — otherwise open growth could exceed the budget and
+        // wait for a later submit/evict to notice.
+        let perCaptureRoom = c.clipSampleCeiling - c.retained.count
+        let aggregateRoom = Self.maxAggregateRetainedSamples - aggregateAudioSamples
+        let take = min(samples.count, max(perCaptureRoom, 0), max(aggregateRoom, 0))
+        if take > 0 { c.retained.append(contentsOf: samples.prefix(take)) }
+        c.original = max(c.original ?? 0, reportedTotal ?? c.retained.count)
+        if take < samples.count, c.droppedFrom == nil {
+            c.droppedFrom = c.retained.count
+        }
+        aggregateAudioSamples += take
+        current = c
+        lock.unlock()
+    }
+
+    /// Called by the actual loaded component immediately before invocation. Unknown or conflicting
+    /// instances cannot be represented as one known version. Matching uses the capture argument only.
+    func engineUsedModel(slot: String, reference: VoiceSharingContributionEncoder.ModelRef?, context: CaptureContext?) {
+        guard ["vad", "wakeword", "asr", "translation", "router"].contains(slot), let context else { return }
+        lock.lock()
+        defer { lock.unlock() }
+        func record(_ capture: inout FrozenCapture) {
+            guard !capture.conflictingModelSlots.contains(slot) else { return }
+            if capture.observedModelSlots.contains(slot), capture.modelReferences[slot] != reference {
+                capture.modelReferences.removeValue(forKey: slot)
+                capture.conflictingModelSlots.insert(slot)
+            } else {
+                capture.observedModelSlots.insert(slot)
+                capture.modelReferences[slot] = reference
+            }
+        }
+        if var capture = current, capture.id == context.id, !capture.terminal {
+            record(&capture)
+            current = capture
+        } else if var entry = terminalRing[context.id], !entry.emitted, !entry.noContribution {
+            record(&entry.capture)
+            terminalRing[context.id] = entry
+        }
+    }
+
+    /// The ENGINE's own report about a stage it actually evaluated for this capture (review bc692f91).
+    /// Only the caller that made the decision may report it: receiving frames does NOT establish a wake
+    /// detection, so `appendSamples` must never infer one. A nil `context` means no capture was open and
+    /// the report is dropped rather than attached to a successor.
+    func engineReported(
+        stage: String, outcome: VoiceSharingContributionEncoder.StageOutcome,
+        context: CaptureContext?, decision: String? = nil
+    ) {
+        var outcome = outcome
+        if let decision { outcome = outcome.withDecision(decision) }
+        lock.lock()
+        defer { lock.unlock() }
+        guard let context else { return }
+        // The engine's decision can land AFTER segmentation ended but BEFORE the completion event is
+        // emitted (a late outcome re-emits from the ring). Record it wherever the capture currently
+        // lives — open, or ring-resident and not yet emitted — so the record that eventually leaves
+        // carries it. A capture already emitted cannot be amended: its record is immutable, which is
+        // the point of the digest.
+        // A stage can be reported MORE THAN ONCE (e.g. routing at classification time, then again at
+        // settlement with its terminal disposition). But a GENERIC carry-forward is unsafe across
+        // state changes (review 5f42fb0c): a completed report would inherit a previous reason, and
+        // an empty_result would inherit previous text/router_input — contradictions or schema
+        // refusals. Nil cannot always mean preserve. So: ONLY routing's classification facts
+        // (predicted names and disposition) are intentionally retained for settlement; every other
+        // member comes from the new report alone, and a nil CLEARS.
+        func merged(_ previous: VoiceSharingContributionEncoder.StageOutcome?,
+                    stage: String
+        ) -> VoiceSharingContributionEncoder.StageOutcome {
+            guard let previous else { return outcome }
+            if stage == "routing",
+               // Retention is constrained to the intended classification→settlement transition
+               // (review 83e0177b). The only INCOMPATIBLE settlement is not_run: the router
+               // declined, so nothing was classified and carrying names would invent a
+               // classification that never happened. failed still concerns the classified action
+               // (its control, spec 012b19dd/78480a17, asserts a failed turn NAMES its
+               // classification), and pending means the classification stands unconcluded.
+               VoiceSharingRecordBinding
+                   .routingDispositionCarriesClassification(outcome.routingDisposition) {
+                return .init(
+                    state: outcome.state,
+                    reason: outcome.reason,
+                    text: outcome.text,
+                    decision: outcome.decision,
+                    translatedText: outcome.translatedText,
+                    targetLanguage: outcome.targetLanguage,
+                    routingDisposition: outcome.routingDisposition,
+                    sourceLanguage: outcome.sourceLanguage,
+                    routerInput: outcome.routerInput,
+                    predictedIntent: outcome.predictedIntent ?? previous.predictedIntent,
+                    predictedTool: outcome.predictedTool ?? previous.predictedTool,
+                    outcome: outcome.outcome)
+            }
+            return outcome
+        }
+        if var c = current, c.id == context.id, !c.terminal, c.sawStart {
+            c.reportedStages[stage] = merged(c.reportedStages[stage], stage: stage)
+            current = c
+            return
+        }
+        if var rec = terminalRing[context.id], !rec.emitted, !rec.noContribution {
+            rec.capture.reportedStages[stage] = merged(rec.capture.reportedStages[stage], stage: stage)
+            terminalRing[context.id] = rec
+        }
+    }
+
+    /// Completion matched against the CONTEXT THE ENGINE CAPTURED, not current state. A nil/unknown context
+    /// (no capture was open when the utterance Task launched) refuses outright.
+    func speechCompleted(_ samples: [Float], context: CaptureContext?, deferEmission: Bool = false) {
+        if let context, deferEmission {
+            lock.lock()
+            if var rec = terminalRing[context.id], !rec.emitted, !rec.noContribution {
+                rec.capture.deferEmissionUntilFinalized = true
+                terminalRing[context.id] = rec
+            }
+            if var c = current, c.id == context.id, !c.terminal {
+                c.deferEmissionUntilFinalized = true
+                current = c
+            }
+            lock.unlock()
+        }
+        if emitLateOutcomeIfTerminal(kind: .completed, context: context) { return }
+        // A late outcome that CANNOT be emitted yet (downstream stages still to come) leaves the capture
+        // ring-resident; the engine finalizes it. Nothing else may be refused by falling through.
+        lock.lock()
+        guard var c = resolve(context) else { lock.unlock(); return }
+        guard !c.terminal, c.sawStart else { lock.unlock(); return }
+        guard stillPermitted(for: c) else {
+            lock.unlock()
+            abandonForGateMove(context: context)
+            return
+        }
+        // FINALIZE ONLY. Every sample of the segment was already delivered by the segmenter's deltas —
+        // the confirmation prefix plus one delta per later call. Appending the utterance again would
+        // duplicate (and, with an in-flight successor, reorder) the audio. `samples` is used solely to
+        // state the original duration.
+        c.original = max(c.original ?? 0, samples.count)
+        c.terminal = true
+        current = nil                       // detach A's completed audio ownership HERE, synchronously,
+                                            // before any successor can start; the ring entry and the
+                                            // event share it via COW from this point
+        aggregateAudioSamples -= c.retained.count
+        markTerminal(c)                     // ring re-registers the (immutable, completed) capture
+        if c.deferEmissionUntilFinalized {
+            // DOWNSTREAM STAGES STILL RUN (spec 2dcf8c5b, review 6fe6d773): ASR/translation/routing
+            // decisions happen AFTER the segment closes, so emitting here would publish a record that can
+            // never carry them. The capture stays ring-resident until the engine finalizes it.
+            let deadline = registerOutcomeDeadlineLocked(for: c.id)
+            lock.unlock()
+            if let deadline { scheduleOutcome(deadline.time, deadline.work) }
+            return
+        }
+        terminalRing[c.id]?.emitted = true
+        cancelOutcomeDeadlineLocked(c.id)
+        let event = makeEvent(kind: .completed, from: c)
+        lock.unlock()
+        submit(event)
+    }
+
+    /// The engine's downstream work for this capture is finished. Emit the completion now, carrying every
+    /// observation the engine reported in the meantime. A capture that is not ring-resident (already
+    /// emitted, or never completed) is a no-op, so a double finalize cannot publish twice.
+    func finalizeDeferredCompletion(context: CaptureContext?) {
+        guard let context else { return }
+        lock.lock()
+        guard var rec = terminalRing[context.id], !rec.emitted else { lock.unlock(); return }
+        // MIRRORS emitLateOutcomeIfTerminal (review 859dac4c): this is the SAME promotion of a terminal
+        // capture into a completed record, so it must honour every safeguard that path applies. Without
+        // these checks a late finalize could resurrect a capture that was genuinely cancelled or withdrawn,
+        // after a gate/identity move it no longer belongs to, or one that was never a deferred completion.
+        guard rec.capture.deferEmissionUntilFinalized else { lock.unlock(); return }
+        if rec.noContribution {
+            // A capture that can never contribute is CONSUMED, never resurrected.
+            cancelOutcomeDeadlineLocked(context.id)
+            rec.emitted = true
+            terminalRing[context.id] = rec
+            lock.unlock()
+            return
+        }
+        let sameConsent = (rec.capture.epoch == epochProvider())
+            && (rec.capture.session == sessionIdentity())
+            && policy.permitsCollection
+            && membership().effectiveEnrolled
+        guard sameConsent else { lock.unlock(); return }
+        cancelOutcomeDeadlineLocked(context.id)
+        rec.emitted = true
+        terminalRing[context.id] = rec
+        let event = makeEvent(kind: .completed, from: rec.capture)
+        lock.unlock()
+        submit(event)
+    }
+
+    /// Cancellation carries no context: it fires from the segmenter's own reset for whatever IT has open,
+    /// which is exactly one capture by construction.
+    func speechCancelled() {
+        lock.lock()
+        // THE OWNER OF THE CANCELLATION IS THE OPEN CAPTURE, and it is decided FIRST (review d3c39ae5).
+        // A deferred ring entry belongs to a segment that already closed: if a successor is open, the
+        // cancellation is about the SUCCESSOR, and consuming the predecessor instead would discard the
+        // wrong capture while leaving the intended one live.
+        if let open = current, !open.terminal, open.sawStart {
+            var c = open
+            c.terminal = true
+            current = nil
+            aggregateAudioSamples -= c.retained.count
+            markTerminal(c, discarded: true)   // a genuine cancel discards the partial FOREVER
+            let event = makeEvent(kind: .cancelled, from: c)
+            lock.unlock()
+            submit(event)
+            return
+        }
+        // No open capture: the cancellation is about the capture the pipeline is still awaiting a finalize
+        // for (spec 2dcf8c5b). Without this a deferred capture would survive and a late finalize could
+        // revive it (review 859dac4c).
+        if var deferred = deferredRingEntryAwaitingCancellationLocked(preferring: nil) {
+            deferred.capture = consumed(deferred.capture)
+            cancelOutcomeDeadlineLocked(deferred.capture.id)
+            deferred.emitted = true
+            deferred.noContribution = true
+            terminalRing[deferred.capture.id] = deferred
+            lock.unlock()
+            return
+        }
+        lock.unlock()
+    }
+
+    /// Cancellation for a NAMED capture. The engine knows which capture it froze; when it says so, that
+    /// binding wins outright and no recency heuristic is consulted.
+    func speechCancelled(context: CaptureContext?) {
+        guard let context else { speechCancelled()
+return }
+        lock.lock()
+        // The named capture may still be OPEN; cancel it where it lives rather than only looking in the ring.
+        if let open = current, open.id == context.id, !open.terminal, open.sawStart {
+            var c = open
+            c.terminal = true
+            current = nil
+            aggregateAudioSamples -= c.retained.count
+            markTerminal(c, discarded: true)
+            let event = makeEvent(kind: .cancelled, from: c)
+            lock.unlock()
+            submit(event)
+            return
+        }
+        guard var rec = deferredRingEntryAwaitingCancellationLocked(preferring: context) else {
+            lock.unlock()
+            return
+        }
+        rec.capture = consumed(rec.capture)
+        cancelOutcomeDeadlineLocked(context.id)
+        rec.emitted = true
+        rec.noContribution = true
+        terminalRing[rec.capture.id] = rec
+        lock.unlock()
+    }
+
+    /// The capture a cancellation is about. DICTIONARY ORDER IS NOT A BINDING (review 15900665): the ring is
+    /// keyed by UUID, so iterating it picks an arbitrary deferred capture. Cancellation has two distinct
+    /// meanings and both must bind deterministically:
+    ///   - an OPEN capture: the cancel is about `current`, exactly as before;
+    ///   - a captured-but-already-closed one: the engine cancels the capture whose context it froze, which
+    ///     is the capture it is still awaiting a finalize for.
+    /// With several deferred captures the most recent one is the one the pipeline is working on, so recency
+    /// — never hashing — decides. A caller with a known context names it explicitly.
+    private func deferredRingEntryAwaitingCancellationLocked(preferring context: CaptureContext?) -> TerminalRecord? {
+        // A NAMED context is a BINDING, not a hint (review bb404153). Falling through to "most recent
+        // unrelated capture" when the named one is stale, already emitted, or ineligible means a
+        // cancellation for a capture that no longer exists silently consumes a DIFFERENT one that was
+        // never cancelled. Named lookup therefore returns its own entry or nothing at all.
+        if let context {
+            guard let named = terminalRing[context.id],
+                named.capture.deferEmissionUntilFinalized || outcomeDeadlines[context.id] != nil, !named.emitted else { return nil }
+            return named
+        }
+        // Unnamed: the caller did not say which capture, so the most recent one is the best available
+        // evidence. Recency is an explicit stamp, never dictionary iteration order.
+        return terminalRing.values
+            .filter { ($0.capture.deferEmissionUntilFinalized || outcomeDeadlines[$0.capture.id] != nil) && !$0.emitted }
+            .max { $0.deferredOrder < $1.deferredOrder }
+    }
+
+    /// Strips audio ownership from a capture that can no longer contribute.
+    private func consumed(_ c: FrozenCapture) -> FrozenCapture {
+        var identityOnly = c
+        cancelOutcomeDeadlineLocked(c.id)
+        aggregateAudioSamples -= identityOnly.retained.count
+        identityOnly.retained = []
+        return identityOnly
+    }
+
+    /// Rejection resolved by CONTEXT. The engine's Task captured identity at utterance launch; this call
+    /// matches that, so B starting before A's reject arrives cannot make A consume B.
+    func segmentRejected(kind: SignalKind, samples: Int, context: CaptureContext?) {
+        if emitLateOutcomeIfTerminal(kind: kind, context: context) { return }
+        lock.lock()
+        guard var c = resolve(context) else { lock.unlock(); return }
+        guard !c.terminal, c.sawStart else { lock.unlock(); return }
+        guard stillPermitted(for: c) else {
+            lock.unlock()
+            abandonForGateMove(context: context)
+            return
+        }
+        c.original = max(c.original ?? 0, samples)
+        if samples > c.retained.count, c.droppedFrom == nil { c.droppedFrom = c.retained.count }
+        c.terminal = true
+        current = nil
+        aggregateAudioSamples -= c.retained.count
+        markTerminal(c)
+        terminalRing[c.id]?.emitted = true
+        cancelOutcomeDeadlineLocked(c.id)
+        let event = makeEvent(kind: kind, from: c)
+        lock.unlock()
+        submit(event)
+    }
+
+    /// The pipeline stopped. A partial owned by this collector is released — it can never complete. Completed
+    /// contributions are untouched: closing listening is not implicit withdrawal.
+    func pipelineStarting() { captureAllowance?.requestPreparation() }
+
+    func pipelineStopped() {
+        captureAllowance?.invalidate()
+        speechCancelled()
+    }
+
+    /// Explicit gate-loss: remote switch off, lease expired, or permission withdrawn, with identity UNCHANGED
+    /// (so the dequeue-time epoch/session check alone would wave the queued work through). Cancels any open
+    /// partial IMMEDIATELY — without waiting for the next signal — and purges every queued event: consent is
+    /// gone, so nothing already in the FIFO may reach the sink either. Without this, "disable" only took
+    /// effect at the next segmentation signal, and a stalled sink could hold stale work for the whole wait.
+    func gateLost() {
+        captureAllowance?.invalidate()
+        lock.lock()
+        // WITHDRAWAL DISPOSAL. Every retained byte dies here, synchronously:
+        //   * queued events (each holds a full audio copy) — purged;
+        //   * the open partial — terminal, ring-remembered for identity only, audio emptied;
+        //   * terminal-ring history — audio emptied (no retained speech survives a withdrawal);
+        //   * the cancellation record itself is CONTENT-FREE: it states that consent ended (identity,
+        //     counts, truncation metadata) and carries NO audio. GATE-control events still bypass the
+        //     live dequeue check — their whole point is to report the loss — but they cannot carry old
+        //     speech, so the bypass cannot deliver withdrawn audio.
+        for i in pending.indices { aggregateAudioSamples -= pending[i].audio.count }
+        pending.removeAll()
+        disposeRingAudio()
+        for key in terminalRing.keys { terminalRing[key]?.noContribution = true }
+        var cancelEvent: SegmentEvent?
+        if var c = current, !c.terminal {
+            c.terminal = true
+            current = nil
+            aggregateAudioSamples -= c.retained.count
+            c.retained.removeAll()
+            markTerminal(c, discarded: true)
+            cancelEvent = makeEvent(kind: .cancelled, from: c)   // audio empty: withdrawal is content-free
+        }
+        lock.unlock()
+        if let cancelEvent { submit(cancelEvent) }
+    }
+
+    /// An account or session transition abandons whatever partial is open UNDER THE PREDECESSOR. Without this,
+    /// A's late completion would be finalized under B's identity.
+    func invalidateForAccountTransition(expectedSession: String?) {
+        captureAllowance?.invalidate()
+        speechCancelled()
+        _ = expectedSession
+    }
+
+    /// Recently-terminal captures, bounded. A late outcome (A's Task finally runs after A was cancelled and
+    /// B is open) must still complete UNDER A — attributed to A's frozen identity and A's frozen audio —
+    /// rather than being dropped as foreign or, worse, adopted by B. Each entry records whether its terminal
+    /// record was already emitted, so a duplicate late outcome emits nothing.
+    private struct TerminalRecord {
+        var capture: FrozenCapture
+        var emitted: Bool
+        /// A capture that can never become a contribution — genuinely cancelled partials AND
+        /// consent-revoked (gate-loss) captures — is remembered for identity bookkeeping only. Its
+        /// late outcomes are CONSUMED silently: never resurrected as deliverable records, never
+        /// emitted twice.
+        var noContribution: Bool = false
+        /// Monotonic order of entry into the ring, so "the capture the pipeline is working on" is a fact
+        /// rather than an artifact of dictionary iteration order.
+        var deferredOrder: UInt64 = 0
+    }
+
+    private var terminalRing: [UUID: TerminalRecord] = [:]
+
+    /// Live count of audio floats the collector owns right now (open + FIFO + ring). Mutated only under
+    /// `lock`. Enforced against `maxAggregateRetainedSamples` at every growth point.
+    private var aggregateAudioSamples = 0
+
+    private func rememberTerminal(_ c: FrozenCapture, noContribution: Bool = false) {
+        aggregateAudioSamples += c.retained.count
+        terminalSequence &+= 1
+        terminalRing[c.id] = TerminalRecord(
+            capture: c, emitted: false, noContribution: noContribution,
+            deferredOrder: terminalSequence)
+        while terminalRing.count > 32 || aggregateAudioSamples > Self.maxAggregateRetainedSamples {
+            guard let oldest = terminalRing.first else { break }
+            aggregateAudioSamples -= oldest.value.capture.retained.count
+            cancelOutcomeDeadlineLocked(oldest.key)
+            terminalRing.removeValue(forKey: oldest.key)
+        }
+    }
+
+    /// Caller holds the observation lock. Work retains identity only, never PCM or the collector.
+    private func registerOutcomeDeadlineLocked(for id: UUID) -> OutcomeDeadline? {
+        guard outcomeDeadlines[id] == nil, let limit = outcomeWaitLimit,
+              let record = terminalRing[id], !record.emitted, !record.noContribution else { return nil }
+        let deadline = OutcomeDeadline(
+            time: monotonicNow() + .nanoseconds(limit.nanoseconds),
+            work: DispatchWorkItem { [weak self] in self?.outcomeDeadlineReached(id) })
+        outcomeDeadlines[id] = deadline
+        return deadline
+    }
+
+    private func cancelOutcomeDeadlineLocked(_ id: UUID) {
+        outcomeDeadlines.removeValue(forKey: id)?.work.cancel()
+    }
+
+    private func outcomeDeadlineReached(_ id: UUID) {
+        lock.lock()
+        guard let deadline = outcomeDeadlines[id] else { lock.unlock(); return }
+        // An injected scheduler may wake early; expiry is always measured by the monotonic clock.
+        guard monotonicNow() >= deadline.time else {
+            lock.unlock()
+            scheduleOutcome(deadline.time, deadline.work)
+            return
+        }
+        cancelOutcomeDeadlineLocked(id)
+        guard var rec = terminalRing[id], !rec.emitted, !rec.noContribution else {
+            lock.unlock()
+            return
+        }
+        rec.emitted = true
+        let allowed = stillPermitted(for: rec.capture)
+        let event = makeEvent(kind: .completed, from: rec.capture)
+        // The immutable event owns any deliverable PCM from here; the timer/ring release theirs.
+        rec.capture = consumed(rec.capture)
+        rec.noContribution = !allowed
+        terminalRing[id] = rec
+        lock.unlock()
+        if allowed {
+            var expired = event
+            expired.outcomeWaitExpired = true
+            submit(expired)
+        }
+    }
+
+    /// Disposes ALL retained audio in the ring (withdrawal path). Identity bookkeeping stays; bytes go.
+    private func disposeRingAudio() {
+        for deadline in outcomeDeadlines.values { deadline.work.cancel() }
+        outcomeDeadlines.removeAll()
+        for key in terminalRing.keys {
+            guard var rec = terminalRing[key] else { continue }
+            aggregateAudioSamples -= rec.capture.retained.count
+            var disposed = rec.capture
+            disposed.retained.removeAll()
+            rec.capture = disposed
+            terminalRing[key] = rec
+        }
+    }
+
+    /// Whether a capture id is still owned by this collector.
+    func owns(_ captureID: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        if obsoleteCaptures.contains(captureID) { return false }
+        return current?.id == captureID
+    }
+
+    // MARK: - Internals
+
+    /// Matches an engine-captured context against the open capture — or, for a capture that already reached
+    /// a terminal state while its Task was still queued, against the terminal ring so the late outcome is
+    /// attributed under its OWN identity. Unknown or mismatched = refused.
+    private func resolve(_ context: CaptureContext?) -> FrozenCapture? {
+        guard let context else { return nil }
+        if let c = current, c.id == context.id { return c }
+        if let rec = terminalRing[context.id], !rec.emitted { return rec.capture }
+        return nil
+    }
+
+    /// A late outcome for an already-terminal capture: emit its record ONCE under its own identity, without
+    /// touching current state. Returns true when handled.
+    private func emitLateOutcomeIfTerminal(kind: SignalKind, context: CaptureContext?) -> Bool {
+        lock.lock()
+        guard let context, var rec = terminalRing[context.id], !rec.emitted else {
+            lock.unlock()
+            return false
+        }
+        // A capture that can never contribute (genuine cancel, withdrawal) is consumed, never
+        // resurrected: no late callback may turn it back into a deliverable record.
+        if rec.noContribution {
+            cancelOutcomeDeadlineLocked(context.id)
+            rec.emitted = true
+            terminalRing[context.id] = rec
+            lock.unlock()
+            return true
+        }
+        // Late attribution honors the CURRENT gate: if identity moved on (account transition rotated the
+        // epoch) the predecessor's completion stays dropped, exactly as before. The reviewer's case — A
+        // queued-not-executed while B starts under the SAME consent — is what this path exists for.
+        let sameConsent = (rec.capture.epoch == epochProvider())
+            && (rec.capture.session == sessionIdentity())
+            && policy.permitsCollection
+            && membership().effectiveEnrolled
+        guard sameConsent else { lock.unlock(); return false }
+        // DEFER (spec 2dcf8c5b, review 6fe6d773): the capture's downstream stages (ASR, translation,
+        // routing) have not run yet. Emitting now would publish an immutable record that can never carry
+        // them — the engine finalizes instead. Reported as "handled" so callers do not fall through into
+        // a second emission path.
+        if kind == .completed, rec.capture.deferEmissionUntilFinalized {
+            lock.unlock()
+            return true
+        }
+        cancelOutcomeDeadlineLocked(context.id)
+        rec.emitted = true
+        terminalRing[context.id] = rec
+        let event = makeEvent(kind: kind, from: rec.capture)
+        lock.unlock()
+        submit(event)
+        return true
+    }
+
+    private func abandonForGateMove(context: CaptureContext?) {
+        lock.lock()
+        guard let c = current, c.id == context?.id, !c.terminal else { lock.unlock(); return }
+        var abandoned = c
+        abandoned.terminal = true
+        current = nil
+        // Correct the transfer: the open ownership is subtracted and the ring records identity
+        // ONLY (discarded), so the move neither double-charges nor strands the partial's bytes.
+        aggregateAudioSamples -= c.retained.count
+        markTerminal(abandoned, discarded: true)
+        let event = makeEvent(kind: .cancelled, from: abandoned)
+        lock.unlock()
+        submit(event)
+    }
+
+    private func markTerminal(_ c: FrozenCapture, discarded: Bool = false) {
+        terminalIDs.insert(c.id)
+        obsoleteCaptures.insert(c.id)
+        if discarded {
+            // A discarded terminal records IDENTITY ONLY: its audio left ownership at the dispose
+            // site (the caller subtracted), and the ring never holds it — there is nothing to
+            // resurrect and nothing to charge the budget for.
+            var identityOnly = c
+            identityOnly.retained = []
+            rememberTerminal(identityOnly, noContribution: true)
+        } else {
+            rememberTerminal(c)
+        }
+        pruneTerminalHistoryIfNeeded()
+    }
+
+    /// Bounded refusal history. Without a bound, a long session with thousands of segments grows these sets
+    /// forever; the aggregate ceiling must cover them, not just the open buffer and FIFO.
+    private func pruneTerminalHistoryIfNeeded() {
+        let total = terminalIDs.count + obsoleteCaptures.count
+        guard total > Self.maxTerminalHistoryIDs else { return }
+        let excess = total - Self.maxTerminalHistoryIDs / 2
+        for id in terminalIDs.prefix(excess) { terminalIDs.remove(id) }
+        for id in obsoleteCaptures.prefix(excess) { obsoleteCaptures.remove(id) }
+    }
+
+    private func makeEvent(kind: SignalKind, from c: FrozenCapture) -> SegmentEvent {
+        let dropped: [DropSpan]
+        if let from = c.droppedFrom, let original = c.original, original > from {
+            dropped = [DropSpan(start: from, end: original)]
+        } else { dropped = [] }
+        // A cancellation is a content-free DISPOSAL record in every case: a genuinely cancelled partial
+        // can never become a contribution, so its record states identity + counts and carries no audio.
+        let audio = kind == .cancelled ? [] : c.retained
+        return SegmentEvent(kind: kind, captureID: c.id, enrollmentEpoch: c.epoch,
+                            authorizationSession: c.session, retainedSamples: c.retained.count,
+                            truncated: !dropped.isEmpty, droppedSpans: dropped,
+                            originalSampleCount: c.original, audio: audio,
+                            isGateControl: kind == .cancelled,
+                            reportedStages: c.reportedStages,
+                            reportedModels: .init(vad: c.modelReferences["vad"], wakeword: c.modelReferences["wakeword"],
+                                                  asr: c.modelReferences["asr"], translation: c.modelReferences["translation"],
+                                                  router: c.modelReferences["router"]),
+                            metadataByteCeiling: c.metadataByteCeiling)
+    }
+
+    // MARK: - Bounded non-blocking handoff
+
+    /// Queues an event and schedules a drain. NEVER blocks the caller. When the bound is reached the NEWEST
+    /// contribution work is dropped and counted — dropping the oldest would strand a capture whose later
+    /// signals had already been delivered.
+    /// The collector OWNS its coordinator gate-loss registration: the token lives exactly as long as
+    /// the collector, which — not the engine — is the object a held sink or queued drain can keep
+    /// alive. Releasing the engine therefore cannot unregister a collector that still owns audio;
+    /// its registration purges it at the next consent loss.
+    var gateLostSubscription: AnyObject?
+
+    /// Audio bytes CURRENTLY owned inside an in-sink call: registered before the sink runs,
+    /// released when it returns. Part of actual ownership for the whole sink duration.
+    private var inFlightSinkAudioSamples = 0
+
+    private func submit(_ event: SegmentEvent) {
+        lock.lock()
+        if deliversSynchronouslyForTesting {
+            aggregateAudioSamples += event.audio.count
+            lock.unlock()
+            deliverUnderSinkOwnership(event)
+            return
+        }
+        if pending.count >= Self.maxPendingSignals
+            || aggregateAudioSamples + event.audio.count > Self.maxAggregateRetainedSamples {
+            overflowCount += 1
+            lock.unlock()
+            return
+        }
+        aggregateAudioSamples += event.audio.count
+        pending.append(event)
+        lock.unlock()
+        workQueue.async { [weak self] in self?.drainNext() }
+    }
+
+    /// Delivers exactly one event per hop. Before handing an event over, re-check that its authorization is
+    /// still the live one: an event produced under epoch/session A must not reach the sink after the account
+    /// moved to B, even if it was queued before the transition. Withdrawal and identity change therefore
+    /// invalidate QUEUED work — the queued path is the one a stalled sink makes long.
+    private func drainNext() {
+        lock.lock()
+        guard !pending.isEmpty else { lock.unlock(); return }
+        let event = pending.removeFirst()
+        // Dropped HERE (before the sink) means the bytes leave the budget immediately; delivered means
+        // they stay counted IN FLIGHT until the sink returns (subtract after the call below).
+        // Live consent check at dequeue: identity AND the policy gate. Epoch/session equality alone would
+        // deliver work queued before a switch-off or lease expiry, because a disable does not change either.
+        let stillValid = event.isGateControl
+            || ((event.enrollmentEpoch == epochProvider())
+                && (event.authorizationSession == sessionIdentity())
+                && policy.permitsCollection
+                && membership().effectiveEnrolled)
+        lock.unlock()
+        guard stillValid else {
+            lock.lock(); aggregateAudioSamples -= event.audio.count; lock.unlock()
+            return   // drop silently: its consent moved on while it waited
+        }
+        deliverUnderSinkOwnership(event)
+    }
+
+    /// Delivers one event with explicit in-sink ownership: counted from before the call until the
+    /// sink RETURNS, then released from the ledger. This is the ONLY place the sink is invoked.
+    private func deliverUnderSinkOwnership(_ event: SegmentEvent) {
+        let n = event.audio.count
+        lock.lock(); inFlightSinkAudioSamples += n; lock.unlock()
+        sink(event)
+        // Ownership ends when the sink RETURNS — not at enqueue.
+        lock.lock()
+        inFlightSinkAudioSamples -= n
+        aggregateAudioSamples -= n
+        lock.unlock()
+    }
+
+    // MARK: - Test seams (production callers never use these)
+
+    /// Samples the collector is ACTUALLY holding for the open capture — reads the buffer, not a counter.
+    /// Number of events currently queued in the FIFO.
+    var pendingCountForTesting: Int {
+        lock.lock(); defer { lock.unlock() }
+        return pending.count
+    }
+
+    /// Live aggregate owned-audio count (open + FIFO + ring) — the value the byte budget enforces.
+    var aggregateAudioSamplesForTesting: Int {
+        lock.lock(); defer { lock.unlock() }
+        return aggregateAudioSamples
+    }
+
+    /// The ledger AUDITED against the live buffers: actually walks what is retained (open buffer,
+    /// every queued event's audio, every ring entry's audio, plus the bytes of any event currently
+    /// INSIDE a sink call). A budget that only trusts its own counter could drift from reality;
+    /// this is the control that catches that.
+    var actualRetainedAudioBreakdownForTesting: (open: Int, fifo: Int, ring: Int, inFlight: Int) {
+        lock.lock(); defer { lock.unlock() }
+        let openCount = current?.retained.count ?? 0
+        let fifoCount = pending.reduce(0) { $0 + $1.audio.count }
+        let ringCount = terminalRing.values.reduce(0) { $0 + $1.capture.retained.count }
+        return (openCount, fifoCount, ringCount, inFlightSinkAudioSamples)
+    }
+
+    var retainedSampleCountForTesting: Int {
+        lock.lock(); defer { lock.unlock() }
+        return current?.retained.count ?? 0
+    }
+
+    /// The retained contribution audio itself — the thing the parity control compares against the
+    /// segmenter's emitted buffer.
+    var retainedCopyForTesting: [Float] {
+        lock.lock(); defer { lock.unlock() }
+        return current?.retained ?? []
+    }
+
+    var currentCaptureIDForTesting: UUID? {
+        lock.lock(); defer { lock.unlock() }
+        return current?.id
+    }
+
+    /// Total identity state: open capture, queued events, refusal sets. The aggregate the ceiling applies to.
+    var aggregateIdentityStateForTesting: (openCaptures: Int, queuedEvents: Int, terminalHistory: Int) {
+        lock.lock(); defer { lock.unlock() }
+        return (current == nil ? 0 : 1, pending.count,
+                terminalIDs.count + obsoleteCaptures.count + terminalRing.count)
+    }
+
+    /// Test seam: waits until every queued event has been delivered.
+    @discardableResult
+    func waitForDrain(timeout: TimeInterval = 5.0) -> Bool {
+        let deadline = Date().addingTimeInterval(timeout)
+        while Date() < deadline {
+            lock.lock(); let remaining = pending.count; lock.unlock()
+            if remaining == 0 {
+                let sem = DispatchSemaphore(value: 0)
+                workQueue.async { sem.signal() }
+                return sem.wait(timeout: .now() + 0.5) == .success
+            }
+            Thread.sleep(forTimeInterval: 0.005)
+        }
+        return false
+    }
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingContributionEncoder.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingContributionEncoder.swift
new file mode 100644
index 000000000..b3802924e
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingContributionEncoder.swift
@@ -0,0 +1,269 @@
+import CryptoKit
+import Foundation
+
+/// Turns collector segment events into the queue's canonical immutable record: the UTF-8 JSON
+/// metadata envelope (`record` + `record_sha256`) and the exact WAV bytes the record declares.
+///
+/// Composition point: the collector's sink calls this, then hands the result to
+/// `VoiceSharingUploadQueue.prepare(metadata:audio:)`. The encoder refuses to emit anything the
+/// queue's own validator (`VoiceSharingRecordBinding.bind` — the same authority recovery and
+/// readiness apply) would reject: it round-trips EVERY output through `bind` before returning, so
+/// a malformed stage outcome or truncation fact fails at collection time, not as a corrupt queue
+/// entry discovered later.
+///
+/// Truthfulness boundary: the OBSERVATION content (stage states, reasons, text) comes from the
+/// pipeline caller — the encoder never fabricates a stage claim, a transcript, or a duration. It
+/// structures and hashes what it is given; `bind` rejects anything outside the allowlists.
+enum VoiceSharingContributionEncoder {
+
+    struct ModelRef: Equatable {
+        let id: String
+        let version: String
+    }
+
+    struct Models: Equatable {
+        let vad: ModelRef?
+        let wakeword: ModelRef?
+        let asr: ModelRef?
+        let translation: ModelRef?
+        let router: ModelRef?
+    }
+
+    struct Provenance {
+        let platform: String
+        let appVersion: String
+        let build: String
+        var captureSessionID: String
+        let models: Models
+        /// Conversion pipeline version for float→PCM s16le. Compiled, NOT an activation value.
+        ///
+        /// WIRE TYPE IS A STRING (spec ruling 2026-10-22): the Worker's record schema requires a
+        /// bounded nonempty string and Android already emits `"v1"`. An Int here produced a
+        /// record the pinned intake rejected (`invalid_audio at audio.conversion_version`), caught
+        /// only by running a REAL encoder fixture through the Worker.
+        let conversionVersion: String
+    }
+
+    /// Caller-supplied stage claim. `state` is one of the record schema's enumerated states;
+    /// `reason` is REQUIRED for any non-completed state and must be stage-enumerated (enforced by
+    /// the round-trip bind). `text` only for a completed ASR stage.
+    struct StageOutcome: Equatable {
+        let state: String
+        let reason: String?
+        let text: String?
+        /// The stage's own decision verdict (the `decision` member the schema defines for bleed). Only a
+        /// site that actually decided may set it; `nil` leaves the member absent.
+        let decision: String?
+        /// What a successful translation actually produced (schema fields that already exist, spec
+        /// d09c320c). Set only by the site that ran the translation.
+        let translatedText: String?
+        let targetLanguage: String?
+        /// Routing's own enumerated field for what became of the routed turn.
+        let routingDisposition: String?
+        /// ASR's language fact (spec 78480a17: the field exists in the owning schema; a site that
+        /// observed the language states it). Nil leaves the member absent.
+        let sourceLanguage: String?
+        /// The exact text handed onward as the command input. Nil leaves the member absent.
+        let routerInput: String?
+        /// Routing's classification, from the site that classified (analytics' own tool/action names).
+        let predictedIntent: String?
+        let predictedTool: String?
+        /// The executor's own verdict for the turn, from `executionOutcome`'s decision site.
+        let outcome: String?
+
+        init(state: String, reason: String? = nil, text: String? = nil, decision: String? = nil,
+             translatedText: String? = nil, targetLanguage: String? = nil,
+             routingDisposition: String? = nil, sourceLanguage: String? = nil,
+             routerInput: String? = nil, predictedIntent: String? = nil,
+             predictedTool: String? = nil, outcome: String? = nil) {
+            self.state = state
+            self.reason = reason
+            self.text = text
+            self.decision = decision
+            self.translatedText = translatedText
+            self.targetLanguage = targetLanguage
+            self.routingDisposition = routingDisposition
+            self.sourceLanguage = sourceLanguage
+            self.routerInput = routerInput
+            self.predictedIntent = predictedIntent
+            self.predictedTool = predictedTool
+            self.outcome = outcome
+        }
+
+        func withDecision(_ decision: String) -> StageOutcome {
+            StageOutcome(state: state, reason: reason, text: text, decision: decision,
+                         translatedText: translatedText, targetLanguage: targetLanguage,
+                         routingDisposition: routingDisposition)
+        }
+    }
+
+    struct Encoded {
+        /// Canonicalized `record` object bytes (JCS), the digest preimage.
+        let recordJSON: Data
+        /// `{"record":…,"record_sha256":…}` — the queue's metadata argument.
+        let metadataEnvelope: Data
+        /// The exact WAV bytes the record's audio block declares.
+        let wav: Data
+    }
+
+    static let sampleRateHz = 16_000
+
+    enum EncodeError: Error, Equatable {
+        /// A nonfinite sample (NaN/±inf) is malformed capture audio: REFUSED, never clamped into
+        /// a fake value and never allowed to trap the process.
+        case nonFiniteSample
+        /// The collector's own ceiling bounds one capture; exceeding it is refused BEFORE WAV
+        /// capacity arithmetic and the UInt32 header sizes are computed.
+        case sampleCountExceedsCeiling
+    }
+
+    static func encode(
+        event: VoiceSharingCollector.SegmentEvent,
+        provenance: Provenance,
+        observations: [String: StageOutcome]
+    ) throws -> Encoded {
+        let wav = try wavBytes(from: event.audio)
+        let record: [String: Any] = [
+            "schema_version": 1,
+            "capture_id": event.captureID.uuidString,
+            "enrollment_epoch": event.enrollmentEpoch,
+            "platform": provenance.platform,
+            "app_version": provenance.appVersion,
+            "build": provenance.build,
+            "capture_session_id": provenance.captureSessionID,
+            "audio": audioBlock(event: event, wav: wav, provenance: provenance),
+            "models": modelsBlock(event.reportedModels ?? provenance.models),
+            "observations": observationsBlock(observations, outcomeWaitExpired: event.outcomeWaitExpired),
+        ]
+        let canonical = try VoiceSharingRecordBinding.canonicalize(record)
+        let recordJSON = Data(canonical.utf8)
+        let digest = SHA256.hash(data: recordJSON).map { String(format: "%02x", $0) }.joined()
+        let envelope: [String: Any] = ["record": record, "record_sha256": digest]
+        let envelopeCanonical = try VoiceSharingRecordBinding.canonicalize(envelope)
+        let encoded = Encoded(
+            recordJSON: recordJSON,
+            metadataEnvelope: Data(envelopeCanonical.utf8),
+            wav: wav)
+        // THE self-check: the queue must accept exactly what we emit. Any structural or
+        // allowlist failure is a collection-time error, never a persisted corrupt entry.
+        _ = try VoiceSharingRecordBinding.bind(envelope: encoded.metadataEnvelope, audio: encoded.wav)
+        return encoded
+    }
+
+    // MARK: WAV (pcm_s16le, mono, 16 kHz, canonical 44-byte header)
+
+    private static func wavBytes(from samples: [Float]) throws -> Data {
+        // Reviewer 9fbb9d24: Float→Int conversion TRAPS on NaN/infinity/overflow — validate and
+        // clamp in the FLOAT domain first, so the advertised rejection policy runs before any
+        // integer conversion exists to crash.
+        guard samples.count <= VoiceSharingCollector.maxRetainedSamples else {
+            throw EncodeError.sampleCountExceedsCeiling
+        }
+        for sample in samples where !sample.isFinite {
+            throw EncodeError.nonFiniteSample
+        }
+        var data = Data(capacity: VoiceSharingRecordBinding.wavHeaderBytes + samples.count * 2)
+        let byteRate = sampleRateHz * 2
+        func append(_ value: UInt32) { withUnsafeBytes(of: value.littleEndian) { data.append(contentsOf: $0) } }
+        func append16(_ value: UInt16) { withUnsafeBytes(of: value.littleEndian) { data.append(contentsOf: $0) } }
+        data.append(contentsOf: Array("RIFF".utf8))
+        append(UInt32(36 + samples.count * 2))
+        data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8))
+        append(16)                          // PCM chunk size
+        append16(1)                         // PCM format
+        append16(1)                         // mono
+        append(UInt32(sampleRateHz))
+        append(UInt32(byteRate))
+        append16(2)                         // block align
+        append16(16)                        // bits per sample
+        data.append(contentsOf: Array("data".utf8))
+        append(UInt32(samples.count * 2))
+        for sample in samples {
+            // Round-nearest with FLOAT-domain clamping: finite out-of-range values pin to ±1
+            // BEFORE scaling, so ±1.0 maps to ±int16's representable bound and no finite input
+            // can overflow the integer conversion.
+            let clampedSample = min(max(sample, -1), 1)
+            let scaled = (clampedSample * 32768).rounded()
+            let clamped = Int16(clamping: Int(scaled))
+            withUnsafeBytes(of: clamped.littleEndian) { data.append(contentsOf: $0) }
+        }
+        return data
+    }
+
+    // MARK: Record blocks
+
+    private static func audioBlock(
+        event: VoiceSharingCollector.SegmentEvent, wav: Data, provenance: Provenance
+    ) -> [String: Any] {
+        var block: [String: Any] = [
+            "sha256": SHA256.hash(data: wav).map { String(format: "%02x", $0) }.joined(),
+            "byte_count": wav.count,
+            "encoding": "pcm_s16le",
+            "sample_rate_hz": sampleRateHz,
+            "channels": 1,
+            "retained_samples": event.retainedSamples,
+            // The collector owns mono Float32 capture; the ORIGINAL format is that, never implied.
+            "original_format": "pcm_f32le",
+            "conversion_version": provenance.conversionVersion,
+            "truncated": event.truncated,
+            "dropped_spans": event.droppedSpans.map {
+                ["start_sample": $0.start, "end_sample": $0.end]
+            },
+        ]
+        if event.truncated {
+            // Explicit, never fabricated: derived from the segmenter's own original count.
+            let original = event.originalSampleCount ?? 0
+            block["original_duration_ms"] = Int((Double(original) / Double(sampleRateHz) * 1000).rounded())
+        }
+        return block
+    }
+
+    private static func modelsBlock(_ models: Models) -> [String: Any] {
+        func ref(_ m: ModelRef?) -> Any { m.map { ["id": $0.id, "version": $0.version] } ?? NSNull() }
+        return [
+            "vad": ref(models.vad),
+            "wakeword": ref(models.wakeword),
+            "asr": ref(models.asr),
+            "translation": ref(models.translation),
+            "router": ref(models.router),
+        ]
+    }
+
+    private static func observationsBlock(_ observations: [String: StageOutcome], outcomeWaitExpired: Bool) -> [String: Any] {
+        var block: [String: Any] = [:]
+        for stage in ["wake", "bleed", "asr", "translation", "routing", "execution"] {
+            guard let outcome = observations[stage] else {
+                // A missing stage is an unstated claim — the caller must state every stage.
+                block[stage] = ["state": "unknown", "reason": outcomeWaitExpired ? "outcome_wait_expired" : "observation_unavailable"]
+                continue
+            }
+            var entry: [String: Any] = ["state": outcome.state]
+            if let reason = outcome.reason { entry["reason"] = reason }
+            if let text = outcome.text { entry["text"] = text }
+            if let decision = outcome.decision { entry["decision"] = decision }
+            if let translated = outcome.translatedText { entry["translated_text"] = translated }
+            if let target = outcome.targetLanguage { entry["target_language"] = target }
+            if let disposition = outcome.routingDisposition {
+                entry["execution_disposition"] = disposition
+            }
+            if let sourceLanguage = outcome.sourceLanguage {
+                entry["source_language"] = sourceLanguage
+            }
+            if let routerInput = outcome.routerInput {
+                entry["router_input"] = routerInput
+            }
+            if let predictedIntent = outcome.predictedIntent {
+                entry["predicted_intent"] = predictedIntent
+            }
+            if let predictedTool = outcome.predictedTool {
+                entry["predicted_tool"] = predictedTool
+            }
+            if let outcomeValue = outcome.outcome {
+                entry["outcome"] = outcomeValue
+            }
+            block[stage] = entry
+        }
+        return block
+    }
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingContributionSink.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingContributionSink.swift
new file mode 100644
index 000000000..8569de5c7
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingContributionSink.swift
@@ -0,0 +1,184 @@
+import Foundation
+import PocketCastsUtils
+
+/// The collector's production sink: turns completed collector events into durable queue entries
+/// (encode → `prepare` → `finalize`), gated on the live collection policy.
+///
+/// Authorization binding (reviewer 5357d089/5b1ba085/70e5fc58): each event captures the CURRENT
+/// revocation generation at enqueue (slot lock, short), and the publication transaction — the
+/// final gate re-checks and `finalize` — runs inside ONE critical section (`publicationLock`)
+/// shared with `noteRevocation()`. A withdrawal cannot interleave between the final check and
+/// publication;
+/// an event queued under a superseded authorization never publishes even if the gate later reads
+/// true again (account switch / off→on). Revocation also routes through the ASSEMBLY gate-lost
+/// handler, which purges both the collector and the durable queue.
+///
+/// Off the audio callback: `handle` reserves a pending slot under a lock (before enqueue — the
+/// bound must hold while the worker is blocked, not merely inside it), enqueues, and returns.
+/// Over the compiled ceiling the event is dropped and logged.
+///
+/// Admission before allocation (reviewer 5b1ba085): the sink asks the queue for its remaining
+/// byte allowance and refuses BEFORE encoding the WAV/metadata copies. `prepare` still re-checks
+/// exactly at write time.
+///
+/// Error discipline: the sink NEVER throws into the segment pipeline. Failures are logged with
+/// opaque IDs only (no audio, no transcript) and the event is dropped.
+final class VoiceSharingContributionSink {
+    /// Compiled ceiling on events awaiting the worker. NOT an activation value.
+    static let maxPendingEvents = 16
+
+    private let queue: VoiceSharingUploadQueue
+    private let isEnabled: () -> Bool
+    private let encoderProvenance: () -> VoiceSharingContributionEncoder.Provenance
+    private let observations: () -> [String: VoiceSharingContributionEncoder.StageOutcome]
+    private let workerQueue = DispatchQueue(label: "fm.auris.voicesharing.contribution-sink")
+
+    /// TWO locks, deliberately (reviewer 70e5fc58): `slotLock` is held ONLY for the short
+    /// admission/accounting steps (slot reservation, generation capture, the final gate read), so
+    /// `handle` returns promptly on the audio caller even while a slow publication is running disk
+    /// work. `publicationLock` serializes the publication transaction with `noteRevocation()` so a
+    /// withdrawal cannot interleave between the final checks and `finalize`. Never nest them in the
+    /// opposite order: publicationLock → slotLock only, never slotLock → publicationLock.
+    private let slotLock = NSLock()
+    private let publicationLock = NSLock()
+    private var revocationGeneration = 0
+    /// Test-visible generation so controls can assert supersession (not just purge) at the boundary.
+    var revocationGenerationForTesting: Int {
+        slotLock.lock(); defer { slotLock.unlock() }
+        return revocationGeneration
+    }
+    /// Bounded pending slot accounting, OUTSIDE the worker (the bound must hold while the worker
+    /// is blocked or slow, so the check cannot live inside the serialized worker block).
+    private var pendingSlots = 0
+
+    /// Test-only seam: called at worker start when set (lets controls block the worker).
+    var testingWorkerGate: (() -> Void)?
+
+    struct PendingEvent {
+        let event: VoiceSharingCollector.SegmentEvent
+        let capturedGeneration: Int
+    }
+
+    init(
+        queue: VoiceSharingUploadQueue,
+        isEnabled: @escaping () -> Bool,
+        encoderProvenance: @escaping () -> VoiceSharingContributionEncoder.Provenance,
+        observations: @escaping () -> [String: VoiceSharingContributionEncoder.StageOutcome] = { [:] }
+    ) {
+        self.queue = queue
+        self.isEnabled = isEnabled
+        self.encoderProvenance = encoderProvenance
+        self.observations = observations
+    }
+
+    /// Consent revocation signal (withdrawal, sign-out, switch-off, lease loss). Bumps the
+    /// generation under the SAME lock the publication transaction holds, so no publication can
+    /// interleave between its final check and `finalize`.
+    func noteRevocation() {
+        publicationLock.lock()
+        slotLock.lock()
+        revocationGeneration += 1
+        slotLock.unlock()
+        publicationLock.unlock()
+    }
+
+    /// Audio-callback safe: slot reservation under lock, then enqueue. No disk, no encode.
+    func handle(_ event: VoiceSharingCollector.SegmentEvent) {
+        // Start and cancellation are collector bookkeeping, not completed audio contributions.
+        // Encoding them would publish an empty immutable record before the actual outcome.
+        guard !event.isGateControl else { return }
+        switch event.kind {
+        case .completed, .rejectedWake, .rejectedBleed: break
+        case .started, .cancelled: return
+        }
+        slotLock.lock()
+        guard pendingSlots < Self.maxPendingEvents else {
+            slotLock.unlock()
+            FileLog.shared.addMessage(
+                "[VoiceSharing] sink saturated, event dropped capture=\(event.captureID)")
+            return
+        }
+        pendingSlots += 1
+        let captured = revocationGeneration
+        slotLock.unlock()
+        workerQueue.async { [self] in
+            defer {
+                slotLock.lock()
+                pendingSlots -= 1
+                slotLock.unlock()
+            }
+            process(PendingEvent(event: event, capturedGeneration: captured))
+        }
+    }
+
+    /// Reads the live revocation generation under the slot lock (short, never held across disk).
+    private func currentGeneration() -> Int {
+        slotLock.lock()
+        defer { slotLock.unlock() }
+        return revocationGeneration
+    }
+
+    /// Test seam: blocks until every enqueued event has been processed.
+    func waitForIdleForTesting() {
+        workerQueue.sync {}
+    }
+
+    private func process(_ pending: PendingEvent) {
+        testingWorkerGate?()
+        // Admission BEFORE allocation: the queue's measured remaining allowance must cover the
+        // worst-case entry (WAV payload + largest legal metadata + protocol overhead) before any
+        // encoded copy exists. prepare re-checks exactly at write time.
+        let worstCase = pending.event.audio.count * 2
+            + VoiceSharingRecordBinding.wavHeaderBytes
+            + VoiceSharingUploadQueue.maxMetadataBytes
+            + VoiceSharingUploadQueue.protocolOverheadBytes
+        guard queue.hasAdmissionAllowance(forBytes: worstCase) else {
+            FileLog.shared.addMessage(
+                "[VoiceSharing] contribution dropped (queue budget) capture=\(pending.event.captureID)")
+            return
+        }
+
+        // The publication transaction: encode + prepare + final revocation check + finalize run
+        // inside the critical section shared with noteRevocation. Only the WORKER takes this lock
+        // for a long interval; `handle` on the audio caller never waits on it.
+        publicationLock.lock()
+        defer { publicationLock.unlock() }
+        // Gate check 1: authorization still current (live switch AND captured generation).
+        guard isEnabled(), currentGeneration() == pending.capturedGeneration else { return }
+        var provenance = encoderProvenance()
+        if let session = pending.event.authorizationSession {
+            provenance.captureSessionID = session
+        }
+        do {
+            // ENGINE-PRODUCED OBSERVATIONS WIN (review c48461e6): the event carries the stages the
+            // recogniser actually reported for this capture; a claim supplied by the caller covers only
+            // stages the engine did not report. A caller can therefore never overwrite a real
+            // observation with its own narrative, and the recorded claim traces to the engine.
+            var claims = observations()
+            for (stage, observed) in pending.event.reportedStages {
+                claims[stage] = observed
+            }
+            let encoded = try VoiceSharingContributionEncoder.encode(
+                event: pending.event, provenance: provenance, observations: claims)
+            guard encoded.metadataEnvelope.count <= pending.event.metadataByteCeiling else { return }
+            // Gate check 2: the encoded bytes must not become a queue entry under a closed gate.
+            guard isEnabled(), currentGeneration() == pending.capturedGeneration else { return }
+            let entry = try queue.prepare(metadata: encoded.metadataEnvelope, audio: encoded.wav)
+            // Gate check 3 + finalize in the SAME critical section: a noteRevocation() cannot
+            // land between this check and publication — it waits for the lock, and the next
+            // reader (purge in the assembly) removes what this transaction published.
+            guard isEnabled(), currentGeneration() == pending.capturedGeneration else {
+                do { try queue.discardUnready(entry) } catch {
+                    FileLog.shared.addMessage(
+                        "[VoiceSharing] revocation discard failed (entry retained, charged) capture=\(pending.event.captureID)")
+                }
+                return
+            }
+            try queue.finalize(entry)
+        } catch {
+            FileLog.shared.addMessage(
+                "[VoiceSharing] contribution dropped kind=\(pending.event.kind) capture=\(pending.event.captureID) error=\(String(describing: type(of: error)))"
+            )
+        }
+    }
+}
