+            return XCTFail("premise: A open")
+        }
+
+        let bodyHeld = DispatchSemaphore(value: 0)
+        let releaseBody = DispatchSemaphore(value: 0)
+        let task = engine.beginUtteranceProcessing([Float](repeating: 0.01, count: 40 * 16)) {
+            bodyHeld.signal()
+            releaseBody.wait()
+        }
+
