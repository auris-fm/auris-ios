+    func test_repeatedFinalizeDoesNotRefreshQueueAge() throws {
+        let clock = MutableClock(start: Date(timeIntervalSince1970: 2_000_000))
+        var q = VoiceSharingUploadQueue(rootDirectory: root, clock: clock.now)
+        let audio = wav()
