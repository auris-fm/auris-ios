+    func test_responseBurstPastThe64KiBCapIsCancelledMidstream() async throws {
+        let provider = RecordingTokenProvider(tokens: ["tok-1", "tok-1"])
+        UploadRecordingURLProtocol.burstOverCapBytes = 64 * 1024 + 1
