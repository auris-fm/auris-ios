new file mode 100644
index 000000000..381b99098
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingCoordinator.swift
@@ -0,0 +1,520 @@
+import Foundation
+import Firebase
+import PocketCastsServer
+import FirebaseRemoteConfig
+import FirebaseAnalytics
+
+/// Composition point for the Voice Sharing feature on iOS.
+///
+/// Owns the policy snapshot and exposes the single decision every other component
+/// asks: may collection run right now? Keeping construction here (rather than a
+/// singleton maze) means tests can build a coordinator with stubbed providers,
+/// exactly like the rest of the voice pipeline injects clocks and sources.
+final class VoiceSharingCoordinator {
+    static var shared = VoiceSharingCoordinator()
+
+    /// Test-only seam so the app's own composition path can be exercised against an injected
+    /// coordinator. Production never calls these; they exist because `shared` is what
+    /// `AppDelegate.setupVoiceSharingIdentityInvalidation` reads by default, and a subscription test has
+    /// to observe the same object the transition will later invalidate.
+    static func setSharedForTesting(_ replacement: VoiceSharingCoordinator) { shared = replacement }
+    static func resetSharedForTesting() { shared = VoiceSharingCoordinator() }
+
+    let policy: VoiceSharingPolicy
+    /// `isAccountEnrolled` must be re-readable at decision time, not sampled once: the policy
+    /// consults it on every `permitsCollection`, so withdrawal or an account switch flips the
+    /// answer without waiting for a lease to lapse. Production fails closed until the enrollment
+    /// API lands in the cloud lane.
+    init(
+        clock: MonotonicClock = SystemMonotonicClock(),
+        readRemoteSwitch: (() -> VoiceSharingPolicy.RemoteSwitchValue)? = nil,
+        isAccountEnrolled: (() -> Bool)? = nil,
+        now: @escaping () -> Date = Date.init,
+        lastFetchTime: @escaping () -> Date? = { RemoteConfig.remoteConfig().lastFetchTime },
+        valueSource: (() -> RemoteValueSource)? = nil,
+        enrollmentStore: VoiceSharingEnrollmentStore? = nil,
+        cohortPublisher: VoiceSharingCohortPublisher? = nil
+    ) {
+        self.nowProvider = now
+        self.monotonicClock = clock
+        self.lastFetchTimeProvider = lastFetchTime
+        self.valueSource = valueSource ?? Self.readSDKValue
+        let store = enrollmentStore ?? VoiceSharingEnrollmentStore.shared
+        self.enrollmentStore = store
+        self.cohortPublisher = cohortPublisher ?? VoiceSharingCohortPublisher(store: store)
+        self.applyingMembershipInvalidation = false
+        self.policy = VoiceSharingPolicy(
+            clock: clock,
+            readRemoteSwitch: readRemoteSwitch ?? Self.defaultReadRemoteSwitch(valueSource: self.valueSource),
+            // The store is the only honest source of "is this account enrolled": it requires BOTH the
+            // user's own opt-in gesture AND a server projection carrying an epoch + accepted disclosure.
+            // Production previously hard-coded `{ false }` because nothing fed membership yet.
+            isAccountEnrolled: isAccountEnrolled ?? { store.currentEffectiveEnrolled }
+        )
+        // EVERY installed lease arms the expiry trigger from the install site, not from this
+        // coordinator's refresh tail. Otherwise a lease installed by another route lapses with no
+        // time-driven revocation: collection stops (safe) but nothing purges buffered or durable audio.
+        // Fired on whatever thread installed the lease, and armed SYNCHRONOUSLY: the install and its
+        // expiry schedule must be one deterministic step. Deferring to the main queue here made the
+        // ordering unspecified — a control could then never distinguish an armed trigger from an
+        // unarmed one, which is exactly the state this hook exists to prevent.
+        self.policy.onLeaseInstalled = { [weak self] _ in
+            self?.scheduleLeaseExpiryTrigger()
+        }
+        // Membership moves must invalidate an in-flight refresh immediately, not at lease expiry: a
+        // withdrawal or account switch that lands while a fetch is running would otherwise install the
+        // departed state's permission when that fetch returns. Registered for ANY store this coordinator
+        // was handed — gating it on ownership left injected stores with no invalidation at all.
+        membershipObserverToken = store.addObserver { [weak self] _ in
+            guard let self else { return }
+            self.refreshCohortAttributes()
+            guard !self.applyingMembershipInvalidation else { return }
+            self.applyingMembershipInvalidation = true
+            defer { self.applyingMembershipInvalidation = false }
+            // Membership moves inside the current session must NOT raise the identity fence: a successful
+            // enrollment has to be able to install on the very next activation, or opting in does nothing.
+            self.policy.invalidateForIdentityChange(kind: .membershipChange)
+            self.consentGateLost()
+        }
+    }
+
+    private let cohortPublisher: VoiceSharingCohortPublisher
+
+    func refreshCohortAttributes() { cohortPublisher.refresh() }
+
+    /// Authoritative membership shared by policy and account operations.
+    let enrollmentStore: VoiceSharingEnrollmentStore
+    private var membershipObserverToken: UUID?
+    /// Re-entrancy latch: the coordinator's lifecycle handlers call the store, whose observer calls back
+    /// here. Without it one sign-out bumps the policy generation twice — the double-transition shape already
+    /// caught once in this feature.
+    private var applyingMembershipInvalidation: Bool
+
+    /// Schedules the lease-expiry purge. Injectable so tests drive the exact deadline; production
+    /// uses `defaultExpiryScheduler` (wall-clock delay computed from the monotonic deadline).
+    /// Each refresh REPLACES the pending schedule (newest token wins), so a renewed lease never
+    /// fires the previous deadline's purge.
+    var expiryScheduler: ((_ delay: TimeInterval, _ body: @escaping () -> Void) -> Void)?
+    static let defaultExpiryScheduler: (_ delay: TimeInterval, @escaping () -> Void) -> Void = { delay, body in
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: body)
+    }
+
+    /// THE expiry trigger: fires at the LEASE DEADLINE itself, without waiting for a refresh, new
+    /// frames, or any other event. At fire time the gate is re-read — if the lease lapsed (or the
+    /// gate is closed for any other reason), consent is gone and the collector must purge NOW.
+    /// A lease renewed in between re-reads open, so a stale schedule is harmless.
+    private func scheduleLeaseExpiryTrigger() {
+        // Deadline and generation are captured in ONE locked policy call: a concurrent install moves
+        // both together, so they can never be paired across installs.
+        guard let target = policy.leaseExpiryTarget() else { return }
+        let delay = max(0, target.deadline - monotonicClock.now())
+        let schedule = expiryScheduler ?? Self.defaultExpiryScheduler
+        schedule(delay) { [weak self] in
+            guard let self else { return }
+            // The barrier is the POLICY's install-publication barrier: every install path (through
+            // this coordinator or a direct policy call) publishes under it, so holding it across
+            // revoke AND fan-out means a fresh lease cannot become visible mid-fan-out.
+            self.policy.installPublicationBarrier.lock()
+            defer { self.policy.installPublicationBarrier.unlock() }
+            if self.policy.revokeIfLeaseExpired(
+                generation: target.generation, deadline: target.deadline) {
+                self.consentGateLost()
+            }
+        }
+    }
+
+    /// One gate-loss registration. Destroying it UNREGISTERS its handler: a pipeline rebuild can
+    /// neither leave the previous collector un-notified nor notify a collector the new pipeline
+    /// already replaced. Each service build registers its own collector; handlers fan out together.
+    public final class GateLostSubscription {
+        private let unregister: () -> Void
+        fileprivate init(unregister: @escaping () -> Void) { self.unregister = unregister }
+        /// Explicit teardown, for a handler that must remove ITSELF during fan-out (reentrant
+        /// teardown): same path as deinit, safe to call from inside a handler invocation.
+        func unregisterNow() { unregister() }
+
+        deinit { unregister() }
+    }
+
+    /// Production gate-loss fan-out. Every pipeline build registers its own collector (via
+    /// `registerGateLostHandler`) so consent loss — membership withdrawal, sign-out, refresh
+    /// observing the gate closed, or the scheduled lease-expiry trigger — purges EVERY collector
+    /// that is still alive and holding audio, and only those. Purging an already-purged collector
+    /// is a no-op.
+    /// Registry state is mutated from MANY threads: registration on pipeline builds, token deinit
+    /// teardown on whatever thread drops the last reference (a drain queue, a sink holder), and the
+    /// expiry trigger on the main queue. Every access is therefore lock-guarded.
+    private var gateLostHandlers: [UUID: () -> Void] = [:]
+    private let gateLostHandlersLock = NSLock()
+
+    /// REENTRANCY CONTRACT, stated HERE at registration because it is a deadlock hazard, not style:
+    /// a registered handler may unregister (itself or others) freely, but MUST NOT synchronously
+    /// install or refresh a lease. The gate-lost fan-out runs under the policy's install-publication
+    /// barrier; a synchronous refresh from a handler would deadlock on that nonrecursive lock.
+    /// Anything a handler needs from a refresh must be scheduled off the fan-out stack.
+    @discardableResult
+    func registerGateLostHandler(_ handler: @escaping () -> Void) -> GateLostSubscription {
+        let id = UUID()
+        gateLostHandlersLock.lock(); gateLostHandlers[id] = handler; gateLostHandlersLock.unlock()
+        return GateLostSubscription { [weak self] in self?.removeGateLostHandler(id) }
+    }
+
+    // MARK: - Test seams
+    /// Number of live gate-lost handlers. Controls use this to prove the PRODUCTION registry —
+    /// not a manual call — is what carries authorization invalidation to the sink.
+    var gateLostHandlerCountForTesting: Int {
+        gateLostHandlersLock.lock(); let n = gateLostHandlers.count; gateLostHandlersLock.unlock()
+        return n
+    }
+
+    /// Fires every registered gate-lost handler exactly as production consent loss does.
+    func fireGateLostHandlersForTesting() {
+        gateLostHandlersLock.lock()
+        let handlers = Array(gateLostHandlers.values)
+        gateLostHandlersLock.unlock()
+        for handler in handlers { handler() }
+    }
+
+    var registerGateLostHandlerForTestingCount: Int {
+        gateLostHandlersLock.lock(); let n = gateLostHandlers.count; gateLostHandlersLock.unlock()
+        return n
+    }
+    func consentGateLostForTesting() { consentGateLost() }
+
+    private func removeGateLostHandler(_ id: UUID) {
+        gateLostHandlersLock.lock(); gateLostHandlers.removeValue(forKey: id); gateLostHandlersLock.unlock()
+    }
+
+    private func consentGateLost() {
+        // SNAPSHOT under the lock, INVOKE outside it: a handler may tear itself (or another
+        // registration) down reentrantly, which re-enters this registry; invoking under the lock
+        // would deadlock that. Snapshot semantics are the contract: a fan-out reaches every
+        // registration alive at the moment the loss was observed.
+        gateLostHandlersLock.lock(); let snapshot = Array(gateLostHandlers.values); gateLostHandlersLock.unlock()
+        for handler in snapshot { handler() }
+    }
+
+    /// A newer remote fetch supersedes enrollment work from every older activation.
+    struct EnrollmentLookup {
+        fileprivate let generation: Int
+        fileprivate let policyToken: VoiceSharingPolicy.FetchToken
+        fileprivate let projectionToken: VoiceSharingEnrollmentStore.ProjectionToken?
+    }
+
+    // apply() notifies observers synchronously after releasing the store lock. A callback may
+    // begin a newer lookup on this same thread; it must supersede us rather than deadlock.
+    private let enrollmentLookupLock = NSRecursiveLock()
+    private var enrollmentLookupGeneration = 0
+    /// Holds the queued follow-up immediately before its intent check; unset in production.
+    var beforeEnrollmentFollowUpForTesting: (() -> Void)?
+
+    func beginEnrollmentLookup() -> EnrollmentLookup {
+        enrollmentLookupLock.lock()
+        defer { enrollmentLookupLock.unlock() }
+        enrollmentLookupGeneration += 1
+        return EnrollmentLookup(
+            generation: enrollmentLookupGeneration,
+            policyToken: policy.tokenForFetchStart(),
+            projectionToken: enrollmentStore.projectionToken())
+    }
+
+    private func lookupIsCurrent(_ lookup: EnrollmentLookup) -> Bool {
+        lookup.generation == enrollmentLookupGeneration
+            && lookup.projectionToken != nil
+            && lookup.projectionToken == enrollmentStore.projectionToken()
+            && lookup.policyToken == policy.tokenForFetchStart()
+    }
+
+    /// Production activation completion: authoritative membership must be read before renewing
+    /// permission. A changed projection invalidates this activation and needs one fresh exchange.
+    func completeActivationWithEnrollment(
+        freshActivationSucceeded: Bool,
+        lookup: EnrollmentLookup,
+        accountClient: VoiceSharingAccountClient? = nil
+    ) async {
+        guard freshActivationSucceeded else { return }
+        let mayFetch = enrollmentLookupLock.withLock { lookupIsCurrent(lookup) }
+        guard mayFetch else { return }
+        let client = accountClient ?? VoiceSharingAccountClient(
+            tokenProvider: CloudTokenProviderRouter.provider(), membershipStore: enrollmentStore)
+        guard let fetched = await client.fetchProjection() else { return }
+
+        let changed: Bool = enrollmentLookupLock.withLock {
+            guard lookupIsCurrent(lookup), fetched.issuedUnder == lookup.projectionToken else { return false }
+            let membershipChanged = enrollmentStore.currentState.membership != fetched.membership
+            guard enrollmentStore.apply(authoritative: fetched.membership, readUnder: fetched.issuedUnder) else {
+                return false
+            }
+            if !membershipChanged {
+                // No new token: only the original, still-current activation can renew the lease.
+                guard lookupIsCurrent(lookup) else { return false }
+                policyRefreshAfterActivation(freshActivationSucceeded: true, fetchToken: lookup.policyToken)
+            }
+            return membershipChanged
+        }
+        guard changed else { return }
+        // Dispatch outside application/observer locks. Local intent or a newer lookup can retire
+        // this follow-up before it runs. The next fetch captures its own authority from scratch.
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.beforeEnrollmentFollowUpForTesting?()
+            let stillCurrent = self.enrollmentLookupLock.withLock {
+                lookup.generation == self.enrollmentLookupGeneration
+                    && fetched.issuedUnder == self.enrollmentStore.projectionToken()
+                    && self.enrollmentStore.currentState.membership == fetched.membership
+            }
+            guard stillCurrent else { return }
+            self.initiateIdentityRecoveryRefresh()
+        }
+    }
+
+    /// Called from the fetch→activate completion path with the caller's evidence about that
+    /// specific callback pair plus the token captured at fetch start. A cached or no-network
+    /// outcome passes `freshActivationSucceeded: false` and cannot renew the lease; a token from
+    /// a superseded identity cannot install at all.
+    func policyRefreshAfterActivation(
+        freshActivationSucceeded: Bool,
+        fetchToken: VoiceSharingPolicy.FetchToken
+    ) {
+        policy.refreshAfterActivation(
+            freshActivationSucceeded: freshActivationSucceeded,
+            fetchToken: fetchToken
+        )
+        // If the refresh observed the gate closed (switch off, account not enrolled, install
+        // refused), any audio the collector still holds is consentless — purge now.
+        if !policy.permitsCollection { consentGateLost() }
+        // The NEW lease's expiry schedule is armed at the INSTALL SITE itself; arming again here
+        // would double-schedule every refresh.
+    }
+
+    /// Freshness plumbing reads the SDK's own bookkeeping rather than trusting `.success`, which
+    /// the SDK also reports for cached returns. Injectable so tests drive the real decision
+    /// function without a live Firebase instance.
+    private let nowProvider: () -> Date
+    private let monotonicClock: MonotonicClock
+    var lastFetchTimeProvider: () -> Date?   // settable so tests drive the real decision function
+
+    /// The SDK-facing seam: exactly the two fields production reads off a config value. Isolated so
+    /// tests drive the SAME extraction path with a faithful fixture — a real `FIRRemoteConfigValue`, or
+    /// an equivalent data/source pair — without live Firebase credentials or configuration.
+    struct RemoteValueSource {
+        let data: Data?
+        let sourceIsRemote: Bool
+    }
+
+    var valueSource: () -> RemoteValueSource
+
+    /// SDK bookkeeping accessors, exposed as functions so call sites read as intent.
+    func nowForFreshnessCheck() -> Date { nowProvider() }
+    func lastFetchTime() -> Date? { lastFetchTimeProvider() }
+
+    /// Freshness predicate used by the production bridge. Requires BOTH:
+    ///  - the SDK timestamp advanced from its own prior value (`previousSDKTime`), and
+    ///  - the new value is past our wall-clock fetch start.
+    ///
+    /// A cached short-circuit leaves the SDK timestamp unchanged, so the first test fails. A backward
+    /// clock jump can leave an OLD cached timestamp still greater than our start, so the second test
+    /// alone is insufficient — that case fails closed here because the timestamp did not move.
+    ///
+    /// This is NOT a monotonic guarantee: it is the strongest statement the SDK's public bookkeeping
+    /// supports, and equal/absent/unmoved timestamps are all treated as "not proven".
+    func lastFetchAdvancedPast(_ startedAt: Date, previousSDKTime: Date?) -> Bool {
+        guard let now = lastFetchTimeProvider() else { return false }
+        if let previousSDKTime, now <= previousSDKTime { return false }   // SDK time did not move
+        return now > startedAt
+    }
+
+    /// Observers registered by the last install (sign-out + login-changed), so a repeat install removes
+    /// BOTH rather than leaking one of them.
+    private var identityObservers: [NSObjectProtocol] = []
+
+    /// The center an installed observer was registered on. Removing an observer must be done through
+    /// the SAME center that added it — `removeObserver(_:)` alone would not reach a non-default center.
+    private var identityCenter: NotificationRegistering?
+
+    /// Subscribes to sign-out/identity change so permission drops synchronously instead of surviving
+    /// inside a still-valid snapshot. IDEMPOTENT by construction: `setupVoiceControlIfNeeded()` runs on
+    /// every activation, so a second call removes the previous subscription (from its actual center)
+    /// before installing a new one. Without that, each activation leaked an observer and one sign-out
+    /// notification fired N invalidations — while a single-activation test could never see it.
+    ///
+    /// Returns the invalidation closure so a composition site that already observes this notification
+    /// can call it directly rather than registering a duplicate.
+    /// The notification API the sign-out wiring needs, isolated behind a protocol (spec e3db4e30 /
+    /// d718c160) because the observer's body reaches `SyncManager` and the app graph: a test cannot
+    /// build that graph, but it CAN drive the REAL registration and callback path if the center is
+    /// injectable. `NotificationCenter` already satisfies this, so production is unchanged — the
+    /// AppDelegate still passes `.default`, and this is a conformance, not a wrapper.
+    protocol NotificationRegistering {
+        func addObserver(forName name: NSNotification.Name?,
+                         object obj: Any?,
+                         queue: OperationQueue?,
+                         using block: @escaping (Notification) -> Void) -> NSObjectProtocol
+        func removeObserver(_ observer: Any)
+    }
+
+    @discardableResult
+    func installIdentityInvalidation(
+        onNotificationCenter center: NotificationRegistering = NotificationCenter.default
+    ) -> () -> Void {
+        removeAllIdentityObservers()
+        let invalidate: () -> Void = { [weak self] in
+            guard let self else { return }
+            self.policy.invalidateForIdentityChange()
+        }
+        // Sign-out: end the lifecycle so nothing begun under it can run, and fence policy installs until the
+        // new account state is readable.
+        let willSignOut = center.addObserver(
+            forName: .serverUserWillBeSignedOut,
+            object: nil,
+            queue: .main
+        ) { [weak self] _ in
+            VoiceSharingSessionGeneration.shared.clear()
+            guard let self else { return }
+            // Sign-out is an IDENTITY transition, not merely a membership change: the new account state is
+            // unreadable, so installs are fenced until a login re-establishes them. The store call also
+            // bumps the generation once through its own observer, so no second invalidate here.
+            self.enrollmentStore.transitionToAccount(signedIn: false)
+            self.policy.raiseIdentityFence()
+            self.consentGateLost()
+        }
+        // Login changed is a STATE CHANGE, not proof of a login. Audited producers:
+        //   AuthenticationHelper.handleSuccessfulSignIn, SyncSigninViewController, SyncSigninView,
+        //   NewEmailViewController  -> all set ServerSettings.setSyncingEmail(...) FIRST, so the app is
+        //                               genuinely signed in by the time this fires: new lifecycle.
+        //   AppDelegate+Analytics   -> repairs a missing ServerSettings.userId; signed in: new lifecycle.
+        //   SignOutHelper.signout   -> posts this AFTER SyncManager.signout() cleared email + userId, i.e.
+        //                              while SIGNED OUT. Treating it as a login would mint a fresh lifecycle
+        //                              and lift the fence with nobody authenticated, letting work begin under
+        //                              a session that does not exist.
+        // So the notification only says "re-derive": establish when auth state says signed in, otherwise end
+        // the lifecycle and KEEP the fence raised.
+        let loginChanged = center.addObserver(
+            forName: .userLoginDidChange,
+            object: nil,
+            queue: .main
+        ) { [weak self] _ in
+            self?.handleLoginStateDidChange()
+        }
+        identityObservers = [willSignOut, loginChanged]
+        identityCenter = center
+        // Cold start into an already-signed-in account: there is no login notification for a session that
+        // predates this process, so installation itself must give the app a lifecycle to act under.
+        if SyncManager.isUserLoggedIn() {
+            VoiceSharingSessionGeneration.shared.ensureLifecycle()
+        }
+        return invalidate
+    }
+
+
+    /// Re-derives the lifecycle from authoritative auth state rather than trusting the notification that
+    /// prompted it. Split out so a composition test can drive the real producer sequence and still assert
+    /// the decision, and so `SignOutHelper`'s trailing post cannot be mistaken for a sign-in.
+    func handleLoginStateDidChange(signedIn: Bool = SyncManager.isUserLoggedIn()) {
+        enrollmentStore.transitionToAccount(signedIn: signedIn)
+        if signedIn {
+            VoiceSharingSessionGeneration.shared.beginNewLifecycle()
+            identityBecameReadable()
+        } else {
+            VoiceSharingSessionGeneration.shared.clear()
+            policy.invalidateForIdentityChange()
+            consentGateLost()
+        }
+    }
+
+    private func removeAllIdentityObservers() {
+        guard !identityObservers.isEmpty, let center = identityCenter else { return }
+        for observer in identityObservers { center.removeObserver(observer) }
+        identityObservers = []
+    }
+
+    /// Called by the identity provider once the new account state is readable; lifts the fence
+    /// so a refresh against the CURRENT identity can install again — and then INITIATES the normal
+    /// refresh, because lifting the fence alone re-arms nothing (review 15a18d5d: production's only
+    /// refresh calls live in AppDelegate launch and the developer menu, so a re-login in a
+    /// long-running process never fetched, never installed, and the gate stayed closed until relaunch).
+    /// Injectable so tests drive the real sequence. NO-OP by default, because the production fetch
+    /// entry point touches Firebase and must be wired where Firebase is configured (VoiceControlAssembly),
+    /// not from a default property initializer a test can trip over.
+    var initiateIdentityRecoveryRefresh: () -> Void = {}
+
+    func identityBecameReadable() {
+        policy.identityBecameReadable()
+        initiateIdentityRecoveryRefresh()
+    }
+
+    deinit {
+        removeAllIdentityObservers()
+        if let membershipObserverToken {
+            enrollmentStore.removeObserver(membershipObserverToken)
+        }
+    }
+
+    /// Default reader: routes the seam's raw fields through the production extraction function.
+    /// Instance wiring passes `Self.defaultReadRemoteSwitch(valueSource:)` so an injected seam is
+    /// actually consulted instead of bypassed by a second static SDK read.
+    static func defaultReadRemoteSwitch(valueSource: @escaping () -> RemoteValueSource) -> () -> VoiceSharingPolicy.RemoteSwitchValue {
+        return {
+            let source = valueSource()
+            return VoiceSharingPolicy.extractRemoteSwitch(
+                data: source.data,
+                sourceIsRemote: source.sourceIsRemote
+            )
+        }
+    }
+
+    /// Reads the live SDK value into the seam's representation. `dataValue` is the UTF-8 payload the
+    /// server published; `.source` distinguishes a genuine remote publication from our compiled
+    /// default (`.default`) or an absent key (`.static`) — neither of which may satisfy the policy.
+    ///
+    /// NOTE: this deliberately does NOT use `numberValue`. FIRRemoteConfigValue implements it as
+    /// `[NSNumber numberWithDouble:self.stringValue.doubleValue]` (vendored Sources/FIRConfigValue.m),
+    /// so it always returns a boxed DOUBLE derived from text and never an ObjC boolean literal. A
+    /// decoder that demanded a boolean literal would reject every real publication — including
+    /// "true" — and the switch could never turn on at all. The faithful signals are the payload bytes
+    /// plus the source.
+    private static func readSDKValue() -> RemoteValueSource {
+        guard FirebaseApp.app() != nil else { return RemoteValueSource(data: nil, sourceIsRemote: false) }
+        let value = RemoteConfig.remoteConfig().configValue(forKey: Constants.RemoteParams.voiceSharingEnabled)
+        return RemoteValueSource(data: value.dataValue as Data, sourceIsRemote: value.source == .remote)
+    }
+}
+
+
+extension NotificationCenter: VoiceSharingCoordinator.NotificationRegistering {}
+
+/// Advisory targeting attributes only. SDK calls do not acknowledge targeting or authorize collection.
+final class VoiceSharingCohortPublisher {
+    private let store: VoiceSharingEnrollmentStore
+    private let configured: () -> Bool
+    private let privacyAllows: () -> Bool
+    private let schedule: (@escaping () -> Void) -> Void
+    private let setProperty: (String?, String) -> Void
+
+    init(store: VoiceSharingEnrollmentStore,
+         configured: @escaping () -> Bool = { FirebaseApp.app() != nil },
+         privacyAllows: @escaping () -> Bool = { !Settings.analyticsOptOut() },
+         schedule: @escaping (@escaping () -> Void) -> Void = { DispatchQueue.main.async(execute: $0) },
+         setProperty: @escaping (String?, String) -> Void = { FirebaseAnalytics.Analytics.setUserProperty($0, forName: $1) }) {
+        self.store = store
+        self.configured = configured
+        self.privacyAllows = privacyAllows
+        self.schedule = schedule
+        self.setProperty = setProperty
+    }
+
+    func refresh() {
+        schedule { [weak self] in
+            guard let self, self.configured() else { return } // No SDK call, no clearing claim.
+            guard self.privacyAllows() else {
+                self.setProperty(nil, "plan")
+                self.setProperty(nil, "voice_sharing_enrolled")
+                return
+            }
+            self.store.publishCurrentCohortAttributes { plan, enrolled in
+                self.setProperty(plan, "plan")
+                self.setProperty(enrolled, "voice_sharing_enrolled")
+            }
+        }
+    }
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingEnrollmentStore.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingEnrollmentStore.swift
new file mode 100644
index 000000000..4d1fbe6dd
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingEnrollmentStore.swift
@@ -0,0 +1,367 @@
+import Foundation
+import PocketCastsServer
+
+/// Backend-authoritative Voice Sharing membership, and the single place local state is allowed to change.
+///
+/// Why a store exists at all: the policy asks `isAccountEnrolled()` at decision time, but that question has
+/// exactly one honest answer source — the server projection. Nothing else on the device may claim
+/// enrollment, including a locally flipped toggle, so this type owns the fold:
+///
+///   * `effectiveEnrolled` is **server state AND the user's local intent**, never either alone. A remote
+///     switch or a UI gesture cannot enable collection by itself; the backend epoch must back it.
+///   * NOTHING orders or compares `membership_revision`: the contract makes it opaque, so any local
+///     comparison would be a guess that fails toward re-enabling a user who already withdrew. Instead every
+///     read and mutation is stamped with a `ProjectionToken` captured BEFORE the request — the account/session
+///     lifecycle plus a membership-operation counter — and a reply may only be applied while BOTH still match
+///     the live session. The counter bumps on each local membership move, so a delayed opt-in cannot
+///     resurrect membership after a withdrawal however its revision is spelled.
+///   * Withdrawal takes effect LOCALLY and immediately — new collection stops without waiting for the
+///     network — because "the user said stop" must not depend on a round trip. The server call still runs,
+///     and its result only reconciles; it is never what stops collection.
+///   * Account transitions replace the whole projection. An account switch cannot inherit the previous
+///     account's enrollment, even if both are enrolled, because the epochs belong to different accounts.
+///
+/// Storage: app-private `UserDefaults`, opaque values only (revision/epoch/disclosure version as received).
+/// It deliberately does NOT store audio, transcripts, or credentials, and it is not the durable contribution
+/// queue — purging queued audio is Task 6's job and must run through `transitionToAccount` / `withdraw` here
+/// so both use one production transition rather than two divergent notions of "stopped".
+final class VoiceSharingEnrollmentStore {
+    static let shared = VoiceSharingEnrollmentStore()
+
+    /// What the policy reads at decision time.
+    struct State: Equatable {
+        var membership: VoiceSharingMembership = .unavailable
+        /// The user's own opt-in gesture, persisted so a launch does not silently re-enable something they
+        /// turned off. Never sufficient on its own — see `effectiveEnrolled`.
+        var localOptIn = false
+        /// True only once a projection has been ACCEPTED FROM THE SERVER IN THIS SESSION. Loading disk can
+        /// never set it: a remembered active epoch plus a remembered opt-in is not permission, because the
+        /// account may have withdrawn on another device, been disabled server-side, or the process may simply
+        /// have restarted into a state the server no longer recognises. Until a current-session reply lands,
+        /// `effectiveEnrolled` is false and collection stays off.
+        var hasAuthoritativeProjection = false
+
+        /// Enrollment requires BOTH halves. This is the property the plan states as
+        /// `test_toggleRequiresDisclosureAcceptance_andBackendEpoch`: flipping a switch locally yields
+        /// enrolled=false until the server publishes acceptance plus an epoch.
+        var effectiveEnrolled: Bool {
+            guard localOptIn, hasAuthoritativeProjection else { return false }
+            let m = membership
+            return m.voiceSharingEnrolled
+                && m.withdrawalState == .active
+                && m.enrollmentEpoch != nil
+                && m.acceptedDisclosureVersion != nil
+        }
+    }
+
+    private let lock = NSLock()
+    private let defaults: UserDefaults
+    private var state = State()
+    private var authoritativeLifecycle: String?
+    private var observers: [UUID: (State) -> Void] = [:]
+
+    private enum Key {
+        static func scoped(_ base: String, _ accountScope: String) -> String { "\(base).\(accountScope)" }
+        static let optIn = "VoiceSharing.localOptIn"
+        static let revision = "VoiceSharing.membershipRevision"
+        static let enrolled = "VoiceSharing.serverEnrolled"
+        static let epoch = "VoiceSharing.enrollmentEpoch"
+        static let disclosure = "VoiceSharing.acceptedDisclosureVersion"
+        static let withdrawal = "VoiceSharing.withdrawalState"
+        static let plan = "VoiceSharing.plan"
+    }
+
+    /// Reads the CURRENT account/session lifecycle generation. A projection is applicable only while the
+    /// lifecycle it was read under is still live — the half no local revision comparison can supply, because
+    /// an opaque revision says nothing about which session produced it.
+    private let sessionIdentityProvider: () -> String?
+
+    init(
+        defaults: UserDefaults = .standard,
+        accountScopeProvider: @escaping () -> String = VoiceSharingEnrollmentStore.currentAccountScope,
+        sessionIdentityProvider: @escaping () -> String? = { VoiceSharingSessionGeneration.shared.currentGeneration() }
+    ) {
+        self.defaults = defaults
+        self.accountScopeProvider = accountScopeProvider
+        self.sessionIdentityProvider = sessionIdentityProvider
+        loadForCurrentAccount()
+    }
+
+    /// Membership is per-account. Keying storage by the signed-in account means signing into a different
+    /// account cannot read the previous account's enrollment out of disk, and signing back in restores the
+    /// user's own prior intent rather than resetting it.
+    private let accountScopeProvider: () -> String
+    private static func currentAccountScope() -> String {
+        // Fail closed to an unscoped-but-stable label when nothing is authenticated.
+        ServerSettings.userId ?? "signed-out"
+    }
+
+    private var scope: String { accountScopeProvider() }
+
+    // MARK: - Reading
+
+    var currentEffectiveEnrolled: Bool {
+        lock.lock(); defer { lock.unlock() }
+        return state.effectiveEnrolled
+    }
+
+    var currentState: State {
+        lock.lock(); defer { lock.unlock() }
+        return state
+    }
+
+    /// Last server-observed revision, sent as `expected_membership_revision` on every mutation.
+    var expectedMembershipRevision: String? {
+        lock.lock(); defer { lock.unlock() }
+        return state.hasAuthoritativeProjection && !state.membership.membershipRevision.isEmpty
+            ? state.membership.membershipRevision : nil
+    }
+
+    var activeEnrollmentEpoch: String? {
+        lock.lock(); defer { lock.unlock() }
+        guard state.effectiveEnrolled else { return nil }
+        return state.membership.enrollmentEpoch
+    }
+
+    /// Executes a bounded synchronous publication against one lock-held state/session snapshot.
+    /// The callback must not reenter the store. No captured observer payload may publish later.
+    func publishCurrentCohortAttributes(_ publish: (String?, String?) -> Void) {
+        lock.lock()
+        defer { lock.unlock() }
+        let lifecycle = sessionIdentityProvider()
+        let operation = operationGeneration
+        let snapshot = state
+        guard lifecycle != nil, lifecycle == authoritativeLifecycle, snapshot.hasAuthoritativeProjection,
+              lifecycle == sessionIdentityProvider(), operation == operationGeneration else {
+            publish(nil, nil)
+            return
+        }
+        publish(snapshot.membership.plan.rawValue, snapshot.effectiveEnrolled ? "true" : "false")
+    }
+
+    /// Account-facing display data is authoritative only for the lifecycle that accepted it.
+    var currentAuthoritativeState: State? {
+        lock.lock(); defer { lock.unlock() }
+        guard state.hasAuthoritativeProjection, let lifecycle = sessionIdentityProvider(),
+              lifecycle == authoritativeLifecycle else { return nil }
+        return state
+    }
+
+    // MARK: - Observing
+
+    /// Called after every state change, on the thread that made it. The coordinator uses this to invalidate
+    /// an in-flight refresh the moment membership moves.
+    @discardableResult
+    func addObserver(_ body: @escaping (State) -> Void) -> UUID {
+        lock.lock()
+        let id = UUID()
+        observers[id] = body
+        lock.unlock()
+        return id
+    }
+
+    func removeObserver(_ id: UUID) {
+        lock.lock(); observers.removeValue(forKey: id); lock.unlock()
+    }
+
+    private func notify() {
+        lock.lock()
+        let snapshot = state
+        let list = Array(observers.values)
+        lock.unlock()
+        for body in list { body(snapshot) }
+    }
+
+    // MARK: - Local intent
+
+    /// The user's opt-in gesture. Recording it does NOT enroll anyone: `effectiveEnrolled` also demands a
+    /// server projection carrying an epoch and accepted disclosure. Callers must not read `true` back as
+    /// permission to collect.
+    func setLocalOptIn(_ value: Bool) {
+        lock.lock()
+        bumpOperationGenerationLocked()
+        state.localOptIn = value
+        defaults.set(value, forKey: Key.scoped(Key.optIn, scope))
+        lock.unlock()
+        notify()
+    }
+
+    // MARK: - Authoritative projection
+
+    /// Applies a server projection issued under `token`.
+    ///
+    /// NO REVISION ORDERING. `membership_revision` is opaque by contract, so any local comparison would be a
+    /// guess — and this guess fails in the dangerous direction: treating a late reply as "not older" and
+    /// accepting it can restore permission a user already withdrew. A projection is applied only if the
+    /// account/session lifecycle AND the membership-operation generation it was read under are both still
+    /// current, so anything fenced since is refused regardless of how its revision is spelled.
+    ///
+    /// Returns false when refused so callers reconcile with a fresh GET rather than show stale state.
+    @discardableResult
+    func apply(authoritative projection: VoiceSharingMembership, readUnder token: ProjectionToken) -> Bool {
+        lock.lock()
+        guard token.lifecycleGeneration == sessionIdentityProvider(),
+              token.operationGeneration == operationGeneration else {
+            lock.unlock()
+            return false
+        }
+        let changed = state.membership != projection || !state.hasAuthoritativeProjection
+        state.membership = projection
+        state.hasAuthoritativeProjection = true
+        authoritativeLifecycle = token.lifecycleGeneration
+        persist(projection)
+        lock.unlock()
+        // Identical authoritative replays announce nothing; first authority in this session must publish.
+        if changed { notify() }
+        return true
+    }
+
+    /// Identifies the exact instant a projection or mutation was issued. Carried by every request made on
+    /// this feature's behalf and checked when its reply lands.
+    struct ProjectionToken: Equatable {
+        let lifecycleGeneration: String
+        let operationGeneration: Int
+    }
+
+    /// Current fence value. Call this BEFORE issuing a request, never after the reply.
+    func projectionToken() -> ProjectionToken? {
+        lock.lock()
+        let operation = operationGeneration
+        lock.unlock()
+        guard let lifecycle = sessionIdentityProvider() else { return nil }
+        return ProjectionToken(lifecycleGeneration: lifecycle, operationGeneration: operation)
+    }
+
+    /// Bumped by every LOCAL membership change (opt-in, withdrawal, account transition), so a reply to a
+    /// request issued before the bump is refused even if the server has advanced nothing yet. That is what
+    /// makes "user opts out, then a slow old GET arrives" impossible to honour.
+    private var operationGeneration: Int = 0
+
+    /// Enrollment as a TRI-STATE for consumers that must not conflate "the server has not told us"
+    /// with "not enrolled" (reviewer 05aaaedc). `nil` means there is no authoritative projection in
+    /// this session — the answer is unknown, not negative.
+    var currentEnrollmentAnswer: Bool? {
+        lock.lock(); defer { lock.unlock() }
+        guard state.hasAuthoritativeProjection else { return nil }
+        return state.effectiveEnrolled
+    }
+
+    /// The current membership-operation generation. Consumers that must prove several reads belong
+    /// to ONE moment (the settings surface) stamp with this: a mutation between their reads bumps it
+    /// and the combination is rejected as incoherent (reviewer e40508a1).
+    var currentEnrollmentGeneration: Int {
+        lock.lock(); defer { lock.unlock() }
+        return operationGeneration
+    }
+
+    private func bumpOperationGenerationLocked() { operationGeneration += 1 }
+
+    /// Replaces the projection from a 409 conflict payload. Surfacing the real state is required; the caller
+    /// must NOT auto-replay the opt-in against the newer revision.
+    /// A 409 carries the server's current projection. Surfacing it is required; auto-replaying the opt-in
+    /// against the newer revision is forbidden, and reconciling happens through a NEW GET under a NEW token.
+    func applyConflict(current projection: VoiceSharingMembership?, readUnder token: ProjectionToken) {
+        guard let projection else { return }
+        apply(authoritative: projection, readUnder: token)
+    }
+
+    // MARK: - Withdrawal
+
+    /// Stops collection IMMEDIATELY and locally, before any network result, and returns the operation the
+    /// caller should send. The returned projection is what the local state now claims; the server reply only
+    /// reconciles it.
+    ///
+    /// This is deliberately not "wait for POST .../withdrawal then clear": a user who opts out must not keep
+    /// contributing while a request is in flight or fails.
+    func withdrawLocally(acceptedServerProjectionAfterward: Bool) -> VoiceSharingMembership {
+        lock.lock()
+        // FENCE FIRST: everything issued before this instant becomes inapplicable the moment the user opts
+        // out. Ordering matters — bumping after the change would leave a window where a late old reply still
+        // matches the old fence value.
+        bumpOperationGenerationLocked()
+        state.localOptIn = false
+        var projected = state.membership
+        projected = VoiceSharingMembership(
+            membershipRevision: projected.membershipRevision,
+            plan: projected.plan,
+            voiceSharingEnrolled: false,
+            enrollmentEpoch: projected.enrollmentEpoch,
+            acceptedDisclosureVersion: projected.acceptedDisclosureVersion,
+            withdrawalState: .withdrawn
+        )
+        state.membership = projected
+        defaults.set(false, forKey: Key.scoped(Key.optIn, scope))
+        persist(projected)
+        lock.unlock()
+        notify()
+        _ = acceptedServerProjectionAfterward
+        return projected
+    }
+
+    // MARK: - Account transitions
+
+    /// Sign-out, account switch, or any lifecycle change: forget everything about the departed account.
+    /// Collection is impossible afterwards until this account's projection says otherwise AND the user opts in
+    /// again — a different account's enrollment never carries over, and neither does its epoch.
+    func transitionToAccount(signedIn: Bool) {
+        lock.lock()
+        bumpOperationGenerationLocked()
+        state = State()
+        if signedIn {
+            // Restore THIS account's remembered intent from disk (never another account's).
+            loadForCurrentAccountLocked()
+        } else {
+            // Signed out: no local intent can matter, and nothing may read as enrolled.
+            state.localOptIn = false
+        }
+        lock.unlock()
+        notify()
+    }
+
+    // MARK: - Persistence
+
+    private func loadForCurrentAccount() {
+        lock.lock(); defer { lock.unlock() }
+        loadForCurrentAccountLocked()
+    }
+
+    /// Cold start restores the user's OWN INTENT and the last known display state, and nothing more.
+    /// `hasAuthoritativeProjection` stays false, so permission cannot come from disk — only from a reply
+    /// received in this session. Keeping the fields loaded (rather than resetting them) means the settings UI
+    /// can still show what the server last said while collection remains off until a GET confirms it.
+    private func loadForCurrentAccountLocked() {
+        let s = scope
+        state.localOptIn = defaults.bool(forKey: Key.scoped(Key.optIn, s))
+        state.hasAuthoritativeProjection = false
+        guard let revision = defaults.string(forKey: Key.scoped(Key.revision, s)), !revision.isEmpty else {
+            state.membership = .unavailable
+            return
+        }
+        let withdrawal = VoiceSharingMembership.WithdrawalState(
+            rawValue: defaults.string(forKey: Key.scoped(Key.withdrawal, s)) ?? ""
+        ) ?? .notEnrolled
+        let plan = VoiceSharingMembership.Plan(
+            rawValue: defaults.string(forKey: Key.scoped(Key.plan, s)) ?? ""
+        ) ?? .free
+        state.membership = VoiceSharingMembership(
+            membershipRevision: revision,
+            plan: plan,
+            voiceSharingEnrolled: defaults.bool(forKey: Key.scoped(Key.enrolled, s)),
+            enrollmentEpoch: defaults.string(forKey: Key.scoped(Key.epoch, s)),
+            acceptedDisclosureVersion: defaults.string(forKey: Key.scoped(Key.disclosure, s)),
+            withdrawalState: withdrawal
+        )
+    }
+
+    private func persist(_ m: VoiceSharingMembership) {
+        let s = scope
+        defaults.set(m.membershipRevision, forKey: Key.scoped(Key.revision, s))
+        defaults.set(m.voiceSharingEnrolled, forKey: Key.scoped(Key.enrolled, s))
+        defaults.set(m.plan.rawValue, forKey: Key.scoped(Key.plan, s))
+        defaults.set(m.withdrawalState.rawValue, forKey: Key.scoped(Key.withdrawal, s))
+        if let epoch = m.enrollmentEpoch { defaults.set(epoch, forKey: Key.scoped(Key.epoch, s)) }
+        else { defaults.removeObject(forKey: Key.scoped(Key.epoch, s)) }
+        if let d = m.acceptedDisclosureVersion { defaults.set(d, forKey: Key.scoped(Key.disclosure, s)) }
+        else { defaults.removeObject(forKey: Key.scoped(Key.disclosure, s)) }
+    }
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingMembership.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingMembership.swift
new file mode 100644
index 000000000..5b2d4723a
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingMembership.swift
@@ -0,0 +1,69 @@
+import Foundation
+
+/// Authoritative membership state for Voice Sharing, exactly as the Go-owned account routes publish it.
+///
+/// Contract source: `docs/specs/voice-recording-uploads.md` at `270dfa5b`, "Authenticated account
+/// operations". Field names below mirror the wire (`schema_version: 1`) rather than inventing a client
+/// vocabulary, and every field is optional-with-a-fail-closed-default so a partial or unknown response can
+/// never read as enrolled.
+struct VoiceSharingMembership: Equatable {
+    /// Server-issued opaque revision. Clients must send the value they last observed as
+    /// `expected_membership_revision`; every successfully applied mutation advances it.
+    let membershipRevision: String
+    let plan: Plan
+    let voiceSharingEnrolled: Bool
+    /// Opaque server-issued epoch. Unknown/stale epochs cannot authorize new collection.
+    let enrollmentEpoch: String?
+    let acceptedDisclosureVersion: String?
+    let withdrawalState: WithdrawalState
+
+    enum Plan: String { case free, pro }
+    enum WithdrawalState: String { case active, withdrawn, notEnrolled }
+
+    /// A missing/unknown projection is NOT enrolled: parsing failure yields this rather than throwing, so
+    /// callers cannot accidentally treat garbage as permission.
+    static let unavailable = VoiceSharingMembership(
+        membershipRevision: "",
+        plan: .free,
+        voiceSharingEnrolled: false,
+        enrollmentEpoch: nil,
+        acceptedDisclosureVersion: nil,
+        withdrawalState: .notEnrolled
+    )
+}
+
+/// Outcome of one account mutation, distinguishing what the caller must do next.
+enum VoiceSharingMutationOutcome: Equatable {
+    /// `200` with a projection, plus the store fence value the mutation was ISSUED under. Application goes
+    /// through the store with that token, which refuses if a withdrawal or account transition landed in the
+    /// meantime. A bare projection would let any caller apply a late success under a token it grabbed after
+    /// the reply, which is exactly how an opted-out user gets re-enabled.
+    case applied(membership: VoiceSharingMembership, issuedUnder: VoiceSharingEnrollmentStore.ProjectionToken)
+    /// `409`: either `membership_conflict` (stale expected revision) or an idempotent-retry replay that
+    /// returned the original result. The client MUST NOT auto-replay a conflicted opt-in against the newer
+    /// revision; renewed opt-in requires fresh user intent.
+    /// `409` with the server's current projection, again carrying the ISSUING fence for the same reason.
+    case conflict(current: VoiceSharingMembership?, issuedUnder: VoiceSharingEnrollmentStore.ProjectionToken)
+    /// `403` ineligible / `422` unsupported disclosure or invalid fields. Never silently enrolled.
+    case refused(reason: RefusalReason)
+    /// `401` — credential rejected; caller refreshes and does not retry blindly.
+    case unauthorized
+    /// `503` or transport failure — retryable, and explicitly not a state change.
+    case unavailableBackend
+    /// The operation's originating session no longer exists: the request is refused BEFORE transport (for
+    /// mutations) or the reply is dropped without applying (for reads), so one account's intent can never be
+    /// sent or consumed under another account's credential.
+    case refusedStaleSession
+
+    enum RefusalReason: String { case ineligible, unsupportedDisclosure, invalidRequest }
+}
+
+/// Deletion is its own operation with its own request identity, independent of enrollment and plan.
+enum VoiceSharingDeletionOutcome: Equatable {
+    /// `202` with opaque `deletion_request_id` + `status: deletion_pending`. Local UI must show this as
+    /// PENDING, never as completed, because local queue removal alone proves nothing about server state.
+    case pending(deletionRequestId: String)
+    case refused(reason: VoiceSharingMutationOutcome.RefusalReason)
+    case unauthorized
+    case unavailableBackend
+}
diff --git a/podcasts/VoiceControl/VoiceSharing/VoiceSharingPolicy.swift b/podcasts/VoiceControl/VoiceSharing/VoiceSharingPolicy.swift
new file mode 100644
index 000000000..11980f7dc
--- /dev/null
+++ b/podcasts/VoiceControl/VoiceSharing/VoiceSharingPolicy.swift
@@ -0,0 +1,419 @@
+import Foundation
+
+/// The validated, immutable client snapshot of the Voice Sharing remote switch.
+///
+/// The contract this type exists to enforce (voice-recording-uploads spec,
+/// "Remote policy"): Firebase supplies CONFIGURATION, never authorization, and a
+/// missing/invalid/expired value must DISABLE the feature. Local defaults can only
+/// ever be `false` — there is no code path where an absent remote value enables
+/// collection. That asymmetry is the whole safety property, so it is expressed in
+/// how snapshots are made: an enabled snapshot requires a valid remotely supplied
+/// Boolean plus a fresh lease plus account enrollment, together or not at all.
+struct VoiceSharingSnapshot: Equatable {
+    let enabledRemotely: Bool
+    /// Elapsed-monotonic instant until which this snapshot may be trusted.
+    let leaseExpiresAt: MonotonicTime
+    /// Enrollment is ACCOUNT state folded into the effective decision here, so no
+    /// caller can read "enabled" from configuration alone.
+    let accountEnrolled: Bool
+
+    func permitsCollection(at now: MonotonicTime) -> Bool {
+        enabledRemotely && accountEnrolled && now < leaseExpiresAt
+    }
+}
+
+/// Reads the single scalar switch through the existing typed-accessor pattern and
+/// installs snapshots only after a completed fetch/activate.
+///
+/// Deliberately does NOT persist any activation timestamp as lease evidence:
+/// monotonic clocks restart with the process, so nothing carried across relaunch
+/// can prove a lease's age, and a restored "valid until" would let a stale cached
+/// value enable collection without a fresh remote read. After restart the ONLY way
+/// to obtain a snapshot is `refreshAfterActivation()` backed by a real
+/// fetch→activate completion. Persisted state may record that a refresh is owed;
+/// it never records that a lease is valid.
+final class VoiceSharingPolicy {
+    /// Conservative compiled default while numeric activation limits remain owner
+    /// decisions (spec "Decisions required before activation"). Stale config
+    /// disables rather than continuing to collect.
+    static let leaseSecondsDefault: TimeInterval = 6 * 60 * 60
+
+    enum RemoteSwitchValue: Equatable {
+        /// A genuine remotely supplied Boolean, read after activate completed.
+        case valid(Bool)
+        /// Absent, wrong-typed, read before activation completed, or produced by a failed
+        /// fetch/activation. Never enables.
+        case unavailable
+    }
+
+    /// Strict decode of a raw published value into a switch decision. This is the PRODUCTION
+    /// decoder — callers pass whatever the config store handed them rather than a pre-decided
+    /// `.valid(...)`, so coercion bugs cannot hide behind injected enums.
+    ///
+    /// Only a real boolean counts. `NSNumber.intValue` truncates (`1.5 -> 1`) and its
+    /// `boolValue` accepts non-boolean strings, so neither may decide this: anything that is
+    /// not a genuine ObjC boolean literal is INVALID, and invalid means disabled.
+    static func decodeRemoteSwitch(_ raw: Any?) -> RemoteSwitchValue {
+        guard let number = raw as? NSNumber else { return .unavailable }
+        if CFGetTypeID(number) == CFBooleanGetTypeID() {
+            return .valid(number.boolValue)
+        }
+        return .unavailable
+    }
+
+    /// SDK-facing extraction. This is the PRODUCTION path and the one controls must drive.
+    ///
+    /// Why it cannot simply read `numberValue`: FIRRemoteConfigValue's implementation is literally
+    /// `[NSNumber numberWithDouble:self.stringValue.doubleValue]` (vendored Sources/FIRConfigValue.m),
+    /// i.e. a boxed DOUBLE derived from text. It is never an ObjC boolean literal, so the strict
+    /// decoder above would reject every real publication — including `"true"` — and the feature could
+    /// never enable. The faithful signal is therefore the UTF-8 payload itself plus `source`.
+    ///
+    /// Accepted remote values are exactly `true` / `false` (case-sensitive, whitespace-tolerant);
+    /// anything else — `1`, `0`, `yes`, `1.5`, empty, absent, non-remote source — is unavailable ⇒ off.
+    static func extractRemoteSwitch(data: Data?, sourceIsRemote: Bool) -> RemoteSwitchValue {
+        guard sourceIsRemote, let data else { return .unavailable }
+        guard let text = String(data: data, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines) else {
+            return .unavailable
+        }
+        switch text {
+        case "true": return .valid(true)
+        case "false": return .valid(false)
+        default: return .unavailable
+        }
+    }
+
+    private let clock: MonotonicClock
+    private let leaseSeconds: TimeInterval
+    private let readRemoteSwitch: () -> RemoteSwitchValue
+    private let isAccountEnrolled: () -> Bool
+    /// Monotonically increasing identity generation. Bumped by every real account transition so a
+    /// callback that began under an older generation can be recognised as stale at install time.
+    private var identityGenerationCounter: Int = 0
+
+    private let lock = NSLock()
+    private var installed: VoiceSharingSnapshot?
+
+    /// THE install-publication barrier (reviews e827a22e, a1809497). It lives HERE, at the single
+    /// install authority, not in any caller: a refresh published through the coordinator and a
+    /// DIRECT `refreshAfterActivation` call both pass through this lock, so no install path can
+    /// publish while an old-generation revocation fan-out is running. The expiry body holds it
+    /// across revoke AND fan-out; every install holds it across making the lease visible and arming.
+    /// HANDLERS INVOKED UNDER THIS BARRIER (the gate-lost fan-out) MUST NOT SYNCHRONOUSLY INSTALL
+    /// OR REFRESH — a synchronous refresh from a handler would deadlock on this nonrecursive lock.
+    /// That rule is restated at handler registration.
+    let installPublicationBarrier = NSLock()
+
+    /// Bumped on EVERY successful install. Expiry revocation is generation-bound: the schedule
+    /// captures the generation at arm time and the revoke validates it under the SAME lock —
+    /// otherwise a renewal that lands between "the lease looks lapsed" and "purge" lets a stale
+    /// expiry revoke a FRESH lease (review 5ae8f430).
+    private var leaseGeneration = 0
+    private var pendingIdentityFence: Int = 0
+
+    init(
+        clock: MonotonicClock = SystemMonotonicClock(),
+        leaseSeconds: TimeInterval = VoiceSharingPolicy.leaseSecondsDefault,
+        readRemoteSwitch: @escaping () -> RemoteSwitchValue,
+        isAccountEnrolled: @escaping () -> Bool
+    ) {
+        self.clock = clock
+        self.leaseSeconds = leaseSeconds
+        self.readRemoteSwitch = readRemoteSwitch
+        self.isAccountEnrolled = isAccountEnrolled
+    }
+
+    /// Called by the existing fetch/activate completion path. Installs exactly one
+    /// snapshot per successful activation. An invalid read CLEARS any previous
+    /// snapshot, so a bad publication takes effect as OFF instead of keeping the
+    /// last good value alive past its lease.
+    /// A fetch-start identity token, captured by the caller BEFORE the network round trip and
+    /// handed back at install time. The policy compares it against current identity atomically,
+    /// so a callback that completes after an account switch — or after the fence has been lifted
+    /// by a newer identity — cannot install under the new identity's authority.
+    struct FetchToken: Equatable {
+        let identityGeneration: Int
+    }
+
+    /// Snapshot of identity for starting a fetch. Call this at FETCH START, not at completion.
+    func tokenForFetchStart() -> FetchToken {
+        lock.lock()
+        defer { lock.unlock() }
+        return FetchToken(identityGeneration: identityGenerationCounter)
+    }
+
+    /// `freshActivationSucceeded` is the caller's evidence that THIS call follows a fetch
+    /// that actually succeeded AND proved a fresh network exchange (see FirebaseManager: it
+    /// compares `lastFetchTime` before/after). It is required: without it a cached/no-network
+    /// outcome would renew the lease on stale values and keep collection alive past the point
+    /// where the server was last consulted.
+    @discardableResult
+    func refreshAfterActivation(
+        freshActivationSucceeded: Bool,
+        fetchToken: FetchToken
+    ) -> VoiceSharingSnapshot? {
+        // A failed activation clears rather than renews, and does not extend any lease.
+        guard freshActivationSucceeded else {
+            // Transient config failure: clear permission, but do NOT touch the identity fence.
+            // Fabricating an identity change here would latch the fence and prevent any later
+            // genuine success from ever installing again. It still VERSIONS and ANNOUNCES: a
+            // rendered "active" must not survive a failed activation.
+            clearInstalledAndAnnounce()
+            return nil
+        }
+        // The fence from an identity change blocks installs until the new identity is readable;
+        // without it, a refresh that belongs to the departed account would restore permission.
+        lock.lock()
+        if pendingIdentityFence > 0 {
+            lock.unlock()
+            return nil
+        }
+        // Verify the token against CURRENT identity before reading config: a transition during
+        // the config read must still invalidate this install, so re-check after the read too.
+        let generationNowAtStart = identityGenerationCounter
+        lock.unlock()
+        let value = readRemoteSwitch()
+        let now = clock.now()
+        lock.lock()
+        // Pre-validate under the policy lock, then DROP it before taking the install barrier. LOCK
+        // ORDER EVERYWHERE IS: installPublicationBarrier OUTER, policy lock INNER (review 32d86559).
+        // The first cut of this edit took the barrier while holding the policy lock — the exact
+        // inverse of the expiry body (barrier, then policy lock) — a textbook inversion: a concurrent
+        // install and expiry could each hold one and wait for the other. Because the pre-validation
+        // and the publication are then two separate policy-lock regions, identity is RE-VALIDATED
+        // under the second region: a transition that lands between them must still refuse the install.
+        guard pendingIdentityFence == 0,
+              fetchToken.identityGeneration == identityGenerationCounter,
+              generationNowAtStart == identityGenerationCounter
+        else { lock.unlock(); return nil }
+        switch value {
+        case .unavailable:
+            installed = nil
+            leaseGeneration += 1
+            lock.unlock()
+            // Announced OUTSIDE the lock (listeners read the policy back).
+            notifyChanged()
+            return nil
+        case .valid(let enabled):
+            let snapshot = VoiceSharingSnapshot(
+                enabledRemotely: enabled,
+                leaseExpiresAt: now + leaseSeconds,
+                // Enrollment is sampled here but NOT treated as immutable: `permitsCollection`
+                // re-reads current identity so withdrawal/sign-out takes effect immediately.
+                accountEnrolled: isAccountEnrolled()
+            )
+            lock.unlock()
+            // TEST-ONLY arrival seam: fires immediately BEFORE the barrier wait, so a control can
+            // await "the installer is at the barrier" instead of sleeping (review 83e0177b). Never
+            // set in production.
+            onInstallBarrierArrivalForTesting?()
+            installPublicationBarrier.lock()
+            lock.lock()
+            guard pendingIdentityFence == 0,
+                  fetchToken.identityGeneration == identityGenerationCounter,
+                  generationNowAtStart == identityGenerationCounter
+            else {
+                lock.unlock()
+                installPublicationBarrier.unlock()
+                return nil
+            }
+            // Publication (installed + generation bump) and arming happen UNDER the install
+            // barrier: no revocation fan-out may run in the gap between a fresh lease becoming
+            // visible and its expiry schedule being armed, whichever caller installed it.
+            installed = snapshot
+            leaseGeneration += 1
+            lock.unlock()
+            // EVERY installed lease announces itself, so expiry-driven revocation cannot depend on the
+            // caller remembering to schedule it. The coordinator arms the expiry trigger here rather
+            // than only at the tail of its refresh (audit finding 2026-10-23: a lease installed by any
+            // other route had no time-driven purge).
+            // Delivered with the POLICY lock released (the handler reads the policy back) and AFTER
+            // the generation is bumped: the arming hook reads it, so arming before the bump would
+            // arm the expiry against the PREVIOUS lease's generation.
+            onLeaseInstalled?(snapshot)
+            installPublicationBarrier.unlock()
+            notifyChanged()  // a new lease changes what the surface displays
+            return snapshot
+        }
+    }
+
+    /// The scheduling token: deadline AND generation read in ONE locked step (review e827a22e —
+    /// reading them separately let a concurrent install pair an old deadline with a new generation).
+    func leaseExpiryTarget() -> (deadline: MonotonicTime, generation: Int)? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard let installed else { return nil }
+        return (installed.leaseExpiresAt, leaseGeneration)
+    }
+
+    /// ATOMIC expiry transition (reviews 5ae8f430, e827a22e): invalidate the lease ONLY if ALL of
+    /// these hold under ONE lock — the lease is still the one the caller armed (generation), it is
+    /// still the SAME deadline (a renewing install moves both), and the deadline has actually
+    /// lapsed. Otherwise a stale timer could revoke an UNEXPIRED fresh lease whose generation it
+    /// happened to pair with. True means the caller owns the revocation fan-out.
+    func revokeIfLeaseExpired(generation: Int, deadline: MonotonicTime) -> Bool {
+        lock.lock()
+        guard leaseGeneration == generation, installed != nil,
+              installed?.leaseExpiresAt == deadline,
+              clock.now() >= deadline
+        else {
+            lock.unlock()
+            return false
+        }
+        installed = nil
+        leaseGeneration += 1
+        lock.unlock()
+        notifyChanged()  // expiry is a displayed transition, not just a stamp change
+        return true
+    }
+
+    /// Synchronous invalidation on withdrawal / account switch. Required because a frozen
+    /// snapshot would otherwise keep a departed account's permission true until its lease
+    /// lapsed (hours). Also fences a late refresh belonging to the previous identity: while a
+    /// generation is pending, installs are refused rather than restoring stale permission.
+    /// Two DIFFERENT things bump identity, and conflating them broke the feature:
+    ///
+    ///  * an unresolved IDENTITY transition (sign-out, account switch) — there is no readable account state
+    ///    yet, so installs must be refused until one exists. That raises the fence.
+    ///  * a MEMBERSHIP change inside the CURRENT session (a withdrawal, or a successful enrollment landing) —
+    ///    the account is perfectly readable; only the previous answer is wrong. This invalidates the
+    ///    snapshot and advances the generation WITHOUT fencing.
+    ///
+    /// Previously every membership notification raised `pendingIdentityFence`, and only a later login
+    /// cleared it. So after a successful enroll the projection could never install again until the user
+    /// signed out and back in — opt-in would appear to do nothing, permanently.
+    enum InvalidationKind {
+        /// Account/session changed and the new state is not readable yet: fence installs.
+        case identityTransition
+        /// Membership moved within the current session: drop the snapshot, do NOT fence.
+        case membershipChange
+
+        var fences: Bool { self == .identityTransition }
+    }
+
+    func invalidateForIdentityChange(kind: InvalidationKind = .identityTransition) {
+        lock.lock()
+        installed = nil
+        if kind.fences {
+            pendingIdentityFence += 1
+        }
+        identityGenerationCounter += 1
+        leaseGeneration += 1  // a cleared permission is a lease version change (reviewer 31c7758f)
+        lock.unlock()
+        // Withdrawal/account switch removes a permission the surface may be showing.
+        notifyChanged()
+    }
+
+    /// Raises the install fence without touching the snapshot, for callers that know the account state is
+    /// unreadable (sign-out). Kept separate from `invalidateForIdentityChange` so a membership move can
+    /// never accidentally fence the feature.
+    func raiseIdentityFence() {
+        lock.lock()
+        installed = nil
+        pendingIdentityFence += 1
+        // The fence CLEARS permission, so the LEASE version must move — but NOT the identity
+        // generation: that counter versions install eligibility, and `invalidateForIdentityChange`
+        // (which the same sign-out already performs) is its single owner. Bumping it here too made
+        // one sign-out advance identity twice, which existing controls correctly reject.
+        leaseGeneration += 1
+        lock.unlock()
+        notifyChanged()
+    }
+
+    /// Called by the identity provider once the new account state is readable. Later refreshes
+    /// then install against the CURRENT identity, never the one that was active when the
+    /// outstanding fetch began.
+    func identityBecameReadable() {
+        lock.lock()
+        defer { lock.unlock() }
+        pendingIdentityFence = 0
+    }
+
+    /// Fired for EVERY successfully installed lease, from the single place a lease can be installed.
+    /// Set by the coordinator; nil in tests that do not care. INVOKED OUTSIDE THE POLICY LOCK (below),
+    /// because the handler reads the policy back and re-entering the lock would deadlock.
+    var onLeaseInstalled: ((VoiceSharingSnapshot) -> Void)?
+
+    /// Test-only signal fired just before an install waits on the publication barrier. See the
+    /// call site for the disclosure; nil in production.
+    var onInstallBarrierArrivalForTesting: (() -> Void)?
+
+    /// The installed lease's expiry DEADLINE, for a scheduler that must fire exactly at expiry.
+    /// Nil when no snapshot is installed — an expiry schedule only makes sense against a live lease.
+    /// Read-only bookkeeping: expiry itself is still enforced by `permitsCollection`; this only lets
+    /// composition trigger the purge at the deadline rather than at the next unrelated event.
+    // MARK: - Change notification (reviewer f62b19a4 / spec fc93e27a)
+
+    /// A displayed fact about the policy changed (lease installed, expired, fenced, or coverage
+    /// withdrawn). The settings surface subscribes so a rendered view cannot stay stale — a
+    /// generation stamp alone only detects a race when somebody reads.
+    private var changeObservers: [UUID: () -> Void] = [:]
+    private let observerLock = NSLock()
+
+    @discardableResult
+    func addChangeObserver(_ observer: @escaping () -> Void) -> UUID {
+        observerLock.lock(); defer { observerLock.unlock() }
+        let token = UUID()
+        changeObservers[token] = observer
+        return token
+    }
+
+    func removeChangeObserver(_ token: UUID) {
+        observerLock.lock(); defer { observerLock.unlock() }
+        changeObservers.removeValue(forKey: token)
+    }
+
+    /// EVERY path that CLEARS a previously visible permission goes through here: it drops the
+    /// snapshot, advances the lease generation (so a consumer's stamp notices) and notifies — the
+    /// three things the reviewer found missing on the activation-failure and config-unavailable
+    /// paths (31c7758f). Callers must NOT hold the policy lock.
+    fileprivate func clearInstalledAndAnnounce() {
+        lock.lock()
+        installed = nil
+        leaseGeneration += 1
+        lock.unlock()
+        notifyChanged()
+    }
+
+    fileprivate func notifyChanged() {
+        observerLock.lock()
+        let observers = Array(changeObservers.values)
+        observerLock.unlock()
+        for observer in observers { observer() }
+    }
+
+    /// The lease generation, exposed so a consumer that must prove several reads belong to one
+    /// moment can detect an install/expiry/fence between them (reviewer 05aaaedc).
+    var currentLeaseGeneration: Int {
+        lock.lock(); defer { lock.unlock() }
+        return leaseGeneration
+    }
+
+    var installedLeaseExpiry: MonotonicTime? {
+        lock.lock()
+        defer { lock.unlock() }
+        return installed.map { $0.leaseExpiresAt }
+    }
+
+    /// Seconds until the installed lease lapses, or nil when no lease is installed. Negative means
+    /// already lapsed. Feeds the settings surface's time-driven refresh (reviewer ffca9a27).
+    var secondsUntilLeaseExpiry: TimeInterval? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard let installed else { return nil }
+        return installed.leaseExpiresAt - clock.now()
+    }
+
+    /// Current effective permission. Expired leases report false without mutating
+    /// state; a fresh `refreshAfterActivation()` is the only path back to enabled.
+    var permitsCollection: Bool {
+        lock.lock()
+        let snapshot = installed
+        let fenced = pendingIdentityFence > 0
+        lock.unlock()
+        guard let snapshot, !fenced else { return false }
+        // Re-check identity NOW instead of trusting the value folded into the snapshot: a
+        // withdrawal or account switch between install and this read must not keep collecting.
+        return snapshot.enabledRemotely && clock.now() < snapshot.leaseExpiresAt && isAccountEnrolled()
+    }
+}
