diff --git a/PocketCastsTests/VoiceControlTests/VoiceSharing/VoiceSharingCanonicalizationParityTests.swift b/PocketCastsTests/VoiceControlTests/VoiceSharing/VoiceSharingCanonicalizationParityTests.swift
