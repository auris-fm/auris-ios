#include "PocketCasts.base.xcconfig"

// The hosted unit tests install the app built from this configuration onto a shared
// simulator, so its launcher name is distinct from the staging install the owner tests with.
APP_DISPLAY_NAME = Auris Debug

PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_ROOT)

OTHER_SWIFT_FLAGS = -D DEBUG

// Debug builds hit the staging gateway directly (owner request, task58 thread
// 04dd0df2 item 1): no separate staging configuration needed for testing. The
// \$() breaks up the // so xcconfig does not treat it as a comment delimiter.
// Baked into the build so it survives reinstalls on a shared simulator.
AURIS_CLOUD_BASE_URL = https:/$()/api-staging.auris.fm
