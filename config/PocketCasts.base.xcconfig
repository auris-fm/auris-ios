#include "Version.xcconfig"

SWIFT_VERSION = 5.0

// Map our custom version values (used by the automation tooling) to the values
// Xcode uses
MARKETING_VERSION = $(VERSION_SHORT)
CURRENT_PROJECT_VERSION = $(VERSION_LONG)

// Define a root bundle identifier so that extensions can append to it
PRODUCT_BUNDLE_IDENTIFIER_ROOT = fm.auris

DEVELOPMENT_TEAM = 6LL2R2A55F

// ONNX Runtime for wake word detection
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/podcasts/VoiceControl/WakeWord
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/podcasts/VoiceControl/WakeWord/onnxruntime_headers $(SRCROOT)/podcasts/VoiceControl/IntentRouter/Native $(SRCROOT)/ThirdParty/llama.cpp/include $(SRCROOT)/ThirdParty/llama.cpp/ggml/include

// CPU-only llama.cpp pin 0eadefebd3f8f92a86d634a0e5b8fffc9dc792c0 (Metal off; whisper stays separate).
LLAMA_SLICE = ios-device
LLAMA_SLICE[sdk=iphonesimulator*] = ios-sim
LIBRARY_SEARCH_PATHS = $(inherited) $(SRCROOT)/ThirdParty/llama-cpp-build/$(LLAMA_SLICE)/src $(SRCROOT)/ThirdParty/llama-cpp-build/$(LLAMA_SLICE)/ggml/src $(SRCROOT)/ThirdParty/llama-cpp-build/$(LLAMA_SLICE)/ggml/src/ggml-blas
OTHER_LDFLAGS = $(inherited) -lllama -lggml -lggml-cpu -lggml-base -lggml-blas -framework Accelerate

SECRETS_DIR = $(HOME)/.configure/pocketcasts-ios/secrets
FIREBASE_SECRETS_PATH = $(SECRETS_DIR)/GoogleService-Info.plist
CREDENTIALS_JSON_PATH = $(SECRETS_DIR)/pocket_casts_credentials.json
GOOGLE_SIGN_IN_SECRETS_PATH = $(SECRETS_DIR)/GoogleSignIn.txt
