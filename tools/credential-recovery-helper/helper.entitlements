<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The helper's OWN access group. It is a distinct binary, so it declares its own rather than
       borrowing the app's; a helper that asked for the app's group would be indistinguishable from
       the app and would defeat the point of a separate reader. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)fm.auris.recoveryhelper</string>
  </array>
</dict>
</plist>
